@model CMS_BAL.ViewModels.PagedResult<CMS_DAL.Models.PendingRegistrationUser>
@{
    ViewData["Title"] = "Registration Approvals";
    string currentSearch = Model.SearchTerm ?? "";
    string currentSortBy = Model.SortColumn ?? "AppliedDate";
    string currentSortOrder = Model.SortDirection ?? "DESC";
    string currentRole = !string.IsNullOrWhiteSpace(ViewBag.CurrentRole as string)
        ? (ViewBag.CurrentRole as string)
        : Context.Request.Query["role"].ToString();

    if (string.IsNullOrWhiteSpace(currentRole))
    {
        currentRole = "All";
    }

    int totalPending = ViewBag.TotalPending ?? Model.TotalCount;
    int studentPending = ViewBag.StudentPending ?? 0;
    int teacherPending = ViewBag.TeacherPending ?? 0;
}

<style>
    /* Premium Stat Metric Cards */
    .stat-metric-card {
        background: #ffffff;
        border: 1px solid rgba(226, 232, 240, 0.8);
        border-radius: 1rem;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s ease;
        position: relative;
        overflow: hidden;
    }
    .stat-metric-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px -5px rgba(0, 0, 0, 0.08) !important;
    }
    .stat-metric-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
    }
    .metric-pending::before  { background: linear-gradient(90deg, #f59e0b, #d97706); }
    .metric-students::before { background: linear-gradient(90deg, #3b82f6, #6366f1); }
    .metric-teachers::before { background: linear-gradient(90deg, #8b5cf6, #ec4899); }

    .icon-box {
        width: 52px;
        height: 52px;
        border-radius: 0.85rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        color: white;
        box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.15);
    }
    .icon-pending  { background: linear-gradient(135deg, #f59e0b, #b45309); }
    .icon-students { background: linear-gradient(135deg, #3b82f6, #1d4ed8); }
    .icon-teachers { background: linear-gradient(135deg, #8b5cf6, #6d28d9); }

    /* Hero Banner */
    .hero-banner {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #172554 100%);
        border-radius: 1.25rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.3);
    }
    .hero-banner::after {
        content: '';
        position: absolute;
        top: -50%;
        right: -20%;
        width: 400px;
        height: 400px;
        background: radial-gradient(circle, rgba(59, 130, 246, 0.15) 0%, rgba(0, 0, 0, 0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        background: #f59e0b;
        border-radius: 50%;
        display: inline-block;
        box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7);
        animation: pulse-amber 2s infinite;
    }
    @@keyframes pulse-amber {
        0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.7); }
        70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(245, 158, 11, 0); }
        100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
    }

    /* Modern Tabs Switcher */
    .nav-pills-modern {
        background: #f1f5f9;
        padding: 0.35rem;
        border-radius: 0.75rem;
        display: inline-flex;
    }
    .nav-pills-modern .nav-link {
        border-radius: 0.5rem;
        color: #64748b;
        font-weight: 600;
        font-size: 0.85rem;
        padding: 0.45rem 1.15rem;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .nav-pills-modern .nav-link.active {
        background: #ffffff;
        color: #0f172a;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    }

    /* Table & Card */
    .user-table-row {
        transition: background-color 0.15s ease-in-out;
    }
    .user-table-row:hover {
        background-color: #f8faff;
    }

    .avatar-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.95rem;
        flex-shrink: 0;
    }

    .btn-approve {
        background: linear-gradient(135deg, #10b981, #059669);
        color: #ffffff;
        border: none;
        transition: all 0.2s ease;
    }
    .btn-approve:hover {
        background: linear-gradient(135deg, #059669, #047857);
        color: #ffffff;
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.35);
    }
</style>

<!-- Hero Banner Header -->
<div class="hero-banner text-white p-4 p-md-4 mb-4">
    <div class="row align-items-center g-3">
        <div class="col-12 col-md-8">
            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-25 px-3 py-1 rounded-pill mb-2 fw-semibold" style="font-size: 0.75rem;">
                <i class="bi bi-shield-check me-1"></i> Identity &amp; Access Management
            </span>
            <h3 class="fw-bold text-white mb-2">Registration Approvals</h3>
            <p class="text-light text-opacity-75 small mb-0" style="max-width: 600px;">
                Review, verify, and activate pending Student and Faculty self-registrations to grant academic portal access.
            </p>
        </div>
        <div class="col-12 col-md-4 text-md-end">
            <div class="d-inline-flex align-items-center gap-2">
                <span class="badge px-3 py-2 rounded-pill fw-semibold shadow-sm" style="background: rgba(255, 255, 255, 0.18) !important; color: #ffffff !important; border: 1px solid rgba(255, 255, 255, 0.3) !important; font-size: 0.82rem;">
                    <span class="pulse-dot me-2"></span> @totalPending Pending Verification
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Premium Stat Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-4">
        <div class="stat-metric-card metric-pending p-3 p-md-4 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small fw-bold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Pending Requests</span>
                    <div class="fs-2 fw-bold text-dark mt-1">@totalPending</div>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill mt-1" style="font-size: 0.72rem;">
                        <i class="bi bi-hourglass-split me-1"></i> Awaiting Admin Action
                    </span>
                </div>
                <div class="icon-box icon-pending">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-4">
        <div class="stat-metric-card metric-students p-3 p-md-4 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small fw-bold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Student Registrations</span>
                    <div class="fs-2 fw-bold text-primary mt-1">@studentPending</div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill mt-1" style="font-size: 0.72rem;">
                        <i class="bi bi-mortarboard me-1"></i> Student Portal Signups
                    </span>
                </div>
                <div class="icon-box icon-students">
                    <i class="bi bi-mortarboard"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-4">
        <div class="stat-metric-card metric-teachers p-3 p-md-4 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-secondary small fw-bold text-uppercase" style="letter-spacing: 0.05em; font-size: 0.72rem;">Faculty / Teachers</span>
                    <div class="fs-2 fw-bold text-purple mt-1" style="color: #7c3aed;">@teacherPending</div>
                    <span class="badge bg-purple-subtle text-purple border rounded-pill mt-1" style="background-color: #f3e8ff; color: #7c3aed; border-color: #e9d5ff; font-size: 0.72rem;">
                        <i class="bi bi-person-video3 me-1"></i> Faculty Portal Signups
                    </span>
                </div>
                <div class="icon-box icon-teachers">
                    <i class="bi bi-person-badge"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Switcher Bar & Search -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
            <div class="nav-pills-modern">
                <a asp-action="Index" asp-route-role="All" asp-route-pageSize="@Model.PageSize" asp-route-search="@currentSearch" class="nav-link @(string.Equals(currentRole, "All", StringComparison.OrdinalIgnoreCase) ? "active" : "")" onclick="sessionStorage.setItem('classcms_approval_tab', 'All');">
                    <i class="bi bi-grid-fill me-1 text-primary"></i> All Applications <span class="badge bg-light text-dark ms-1">@totalPending</span>
                </a>
                <a asp-action="Index" asp-route-role="Student" asp-route-pageSize="@Model.PageSize" asp-route-search="@currentSearch" class="nav-link @(string.Equals(currentRole, "Student", StringComparison.OrdinalIgnoreCase) ? "active" : "")" onclick="sessionStorage.setItem('classcms_approval_tab', 'Student');">
                    <i class="bi bi-mortarboard me-1 text-primary"></i> Students <span class="badge bg-primary-subtle text-primary ms-1">@studentPending</span>
                </a>
                <a asp-action="Index" asp-route-role="Teacher" asp-route-pageSize="@Model.PageSize" asp-route-search="@currentSearch" class="nav-link @(string.Equals(currentRole, "Teacher", StringComparison.OrdinalIgnoreCase) ? "active" : "")" onclick="sessionStorage.setItem('classcms_approval_tab', 'Teacher');">
                    <i class="bi bi-person-video3 me-1" style="color: #7c3aed;"></i> Teachers <span class="badge ms-1" style="color: #7c3aed; background-color: #f3e8ff;">@teacherPending</span>
                </a>
            </div>

            <div>
                <form method="get" asp-action="Index" class="d-flex align-items-center gap-2 m-0">
                    <input type="hidden" name="page" value="1" />
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    <input type="hidden" name="role" value="@currentRole" />
                    <input type="hidden" name="sortBy" value="@currentSortBy" />
                    <input type="hidden" name="sortOrder" value="@currentSortOrder" />

                    <div class="input-group input-group-sm shadow-sm" style="min-width: 270px; max-width: 380px;">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control border-start-0 border-end-0" placeholder="Search applicant, email, phone..." value="@currentSearch" />
                        @if (!string.IsNullOrWhiteSpace(currentSearch))
                        {
                            <a asp-action="Index" asp-route-role="@currentRole" asp-route-pageSize="@Model.PageSize" class="btn btn-outline-secondary border-start-0 bg-white" title="Clear Search">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                        <button type="submit" class="btn btn-primary px-3 fw-semibold">
                            Search
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- APPLICATIONS TABLE CARD -->
@if (!Model.Data.Any())
{
    <div class="text-center py-5">
        <div class="rounded-circle bg-success bg-opacity-10 d-inline-flex p-4 text-success mb-3 fs-1 shadow-sm">
            <i class="bi bi-check-circle-fill"></i>
        </div>
        <h4 class="fw-bold text-dark mb-2">
            @(string.IsNullOrWhiteSpace(currentSearch) && string.Equals(currentRole, "All", StringComparison.OrdinalIgnoreCase) ? "All Caught Up!" : "No Applications Found")
        </h4>
        <p class="text-secondary small mb-3" style="max-width: 480px; margin: 0 auto;">
            @if (!string.IsNullOrWhiteSpace(currentSearch))
            {
                <span>No pending registrations matched your search criteria. Try clearing the search.</span>
            }
            else if (!string.Equals(currentRole, "All", StringComparison.OrdinalIgnoreCase))
            {
                <span>There are currently 0 pending @(string.Equals(currentRole, "Teacher", StringComparison.OrdinalIgnoreCase) ? "Faculty / Teacher" : currentRole) registrations waiting for verification.</span>
            }
            else
            {
                <span>There are currently no pending Student or Faculty registrations waiting for verification.</span>
            }
        </p>
        <div class="d-inline-flex gap-2 flex-wrap justify-content-center">
            @if (!string.IsNullOrWhiteSpace(currentSearch))
            {
                <a asp-action="Index" asp-route-role="@currentRole" asp-route-pageSize="@Model.PageSize" class="btn btn-outline-secondary btn-sm px-4 rounded-pill">
                    <i class="bi bi-x-circle me-1"></i> Clear Search
                </a>
            }
            @if (!string.Equals(currentRole, "All", StringComparison.OrdinalIgnoreCase))
            {
                <a asp-action="Index" asp-route-role="All" asp-route-pageSize="@Model.PageSize" class="btn btn-outline-primary btn-sm px-4 rounded-pill" onclick="sessionStorage.setItem('classcms_approval_tab', 'All');">
                    <i class="bi bi-grid me-1"></i> View All Applications (@totalPending)
                </a>
            }
        </div>
    </div>
}
else
{
    <!-- Sort Info Bar -->
    <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
        <div class="text-secondary small">
            <span class="badge bg-light text-secondary border px-2 py-1">
                <i class="bi bi-sort-down me-1 text-primary"></i>Sorted by: 
                <strong class="text-dark">@(currentSortBy == "name" ? "Applicant Name" : currentSortBy == "role" ? "Role / Type" : "Applied Date")</strong>
                (@(currentSortOrder == "ASC" ? "Ascending" : "Descending"))
            </span>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="small text-muted fw-semibold text-nowrap">Sort:</span>
            <div class="btn-group btn-group-sm shadow-sm" role="group">
                <a asp-action="Index" 
                   asp-route-pageSize="@Model.PageSize" 
                   asp-route-search="@currentSearch" 
                   asp-route-role="@currentRole"
                   asp-route-sortBy="AppliedDate" 
                   asp-route-sortOrder="@(currentSortBy == "AppliedDate" && currentSortOrder == "DESC" ? "ASC" : "DESC")" 
                   class="btn @(currentSortBy == "AppliedDate" ? "btn-primary" : "btn-outline-secondary bg-white")">
                    Recent @(currentSortBy == "AppliedDate" ? (currentSortOrder == "ASC" ? "↑" : "↓") : "")
                </a>
                <a asp-action="Index" 
                   asp-route-pageSize="@Model.PageSize" 
                   asp-route-search="@currentSearch" 
                   asp-route-role="@currentRole"
                   asp-route-sortBy="name" 
                   asp-route-sortOrder="@(currentSortBy == "name" && currentSortOrder == "ASC" ? "DESC" : "ASC")" 
                   class="btn @(currentSortBy == "name" ? "btn-primary" : "btn-outline-secondary bg-white")">
                    Name @(currentSortBy == "name" ? (currentSortOrder == "ASC" ? "↑" : "↓") : "")
                </a>
                <a asp-action="Index" 
                   asp-route-pageSize="@Model.PageSize" 
                   asp-route-search="@currentSearch" 
                   asp-route-role="@currentRole"
                   asp-route-sortBy="role" 
                   asp-route-sortOrder="@(currentSortBy == "role" && currentSortOrder == "ASC" ? "DESC" : "ASC")" 
                   class="btn @(currentSortBy == "role" ? "btn-primary" : "btn-outline-secondary bg-white")">
                    Role @(currentSortBy == "role" ? (currentSortOrder == "ASC" ? "↑" : "↓") : "")
                </a>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-uppercase text-secondary">
                    <tr>
                        <th class="ps-4" style="font-size: 0.72rem;">Applicant</th>
                        <th style="font-size: 0.72rem;">Role / Type</th>
                        <th style="font-size: 0.72rem;">Contact Details</th>
                        <th style="font-size: 0.72rem;">Reference / Details</th>
                        <th style="font-size: 0.72rem;">Applied Date</th>
                        <th class="text-end pe-4" style="font-size: 0.72rem;">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    @foreach (var user in Model.Data)
                    {
                        string initial = !string.IsNullOrWhiteSpace(user.FullName) ? user.FullName[0].ToString().ToUpper() : "U";
                        bool isTeacher = string.Equals(user.RoleName, "Teacher", StringComparison.OrdinalIgnoreCase);

                        <tr class="user-table-row">
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="avatar-circle @(isTeacher ? "bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25" : "bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25") shadow-sm">
                                        @initial
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">@user.FullName</div>
                                        <div class="text-secondary small d-flex align-items-center gap-1">
                                            <i class="bi bi-envelope text-muted"></i>@user.Email
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (isTeacher)
                                {
                                    <span class="badge border px-3 py-1 rounded-pill fw-semibold" style="background-color: #fef3c7; color: #b45309; border-color: #fde68a;">
                                        <i class="bi bi-person-video3 me-1"></i> Faculty / Teacher
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill fw-semibold">
                                        <i class="bi bi-mortarboard me-1"></i> Student
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-1 text-dark">
                                    <i class="bi bi-telephone text-secondary"></i>
                                    <span>@(string.IsNullOrWhiteSpace(user.Mobile) ? "N/A" : user.Mobile)</span>
                                </div>
                            </td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(user.ReferenceCode))
                                {
                                    <span class="badge bg-light text-dark border px-2 py-1 rounded-pill fw-semibold">
                                        <i class="bi bi-hash me-1 text-primary"></i>@user.ReferenceCode
                                    </span>
                                }
                                @if (!string.IsNullOrWhiteSpace(user.ExtraInfo))
                                {
                                    <div class="text-secondary small mt-1" style="font-size: 0.74rem;">
                                        @user.ExtraInfo
                                    </div>
                                }
                                @if (string.IsNullOrWhiteSpace(user.ReferenceCode) && string.IsNullOrWhiteSpace(user.ExtraInfo))
                                {
                                    <span class="text-muted small">Standard Registration</span>
                                }
                            </td>
                            <td>
                                <div class="text-dark fw-semibold">@user.CreatedAt.ToString("dd MMM yyyy")</div>
                                <div class="text-muted small" style="font-size: 0.73rem;">
                                    <i class="bi bi-clock me-1"></i>@user.CreatedAt.ToString("hh:mm tt")
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-inline-flex align-items-center gap-2" style="gap: 8px;">
                                    <!-- Approve Button with Modal Trigger -->
                                    <button type="button" 
                                            class="btn btn-sm btn-approve px-3 py-1 rounded-2 fw-semibold shadow-sm open-approve-btn"
                                            data-id="@user.UserId"
                                            data-name="@user.FullName"
                                            data-role="@user.RoleName"
                                            title="Approve &amp; Activate Account">
                                        <i class="bi bi-check-lg me-1"></i> Approve
                                    </button>

                                    <!-- Reject Button with Modal Trigger -->
                                    <button type="button" 
                                            class="btn btn-sm btn-outline-danger px-2.5 py-1 rounded-2 open-reject-btn"
                                            style="padding: 0.28rem 0.6rem;"
                                            data-id="@user.UserId"
                                            data-name="@user.FullName"
                                            data-role="@user.RoleName"
                                            title="Reject Application">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        @await Html.PartialAsync("_PaginationBar", Model)
    </div>
}

<!-- MODAL: CONFIRM APPROVE -->
<div class="modal fade" id="approveConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-body text-center p-4 pt-5">
                <div class="rounded-circle bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center mb-3" style="width: 68px; height: 68px; font-size: 2rem;">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Confirm Registration Approval</h5>
                <p class="text-secondary small mb-4 px-2">
                    Are you sure you want to approve and activate <strong class="text-dark" id="modalApproveName">Applicant Name</strong> as <strong class="text-primary" id="modalApproveRole">Role</strong>?<br />
                    <span class="text-muted small mt-1 d-inline-block">This account will be activated immediately and granted academic portal access.</span>
                </p>
                <div class="d-flex align-items-center justify-content-center gap-2">
                    <button type="button" class="btn btn-light px-4 py-2 rounded-3 text-secondary fw-semibold border" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <form id="confirmApproveForm" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnRole" value="@currentRole" />
                        <button type="submit" class="btn btn-success px-4 py-2 rounded-3 fw-semibold shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-check2-circle"></i> Yes, Approve
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL: CONFIRM REJECT -->
<div class="modal fade" id="rejectConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-body text-center p-4 pt-5">
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 68px; height: 68px; font-size: 2rem;">
                    <i class="bi bi-person-x-fill"></i>
                </div>
                <h5 class="fw-bold text-dark mb-2">Confirm Application Rejection</h5>
                <p class="text-secondary small mb-4 px-2">
                    Are you sure you want to reject the application for <strong class="text-dark" id="modalRejectName">Applicant Name</strong>?<br />
                    <span class="text-danger small mt-1 d-inline-block">This application will be permanently removed. This action cannot be undone.</span>
                </p>
                <div class="d-flex align-items-center justify-content-center gap-2">
                    <button type="button" class="btn btn-light px-4 py-2 rounded-3 text-secondary fw-semibold border" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <form id="confirmRejectForm" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnRole" value="@currentRole" />
                        <button type="submit" class="btn btn-danger px-4 py-2 rounded-3 fw-semibold shadow-sm d-flex align-items-center gap-2">
                            <i class="bi bi-trash3"></i> Yes, Reject
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Tab state persistence
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.has('role')) {
                sessionStorage.setItem('classcms_approval_tab', urlParams.get('role'));
            } else {
                const savedRole = sessionStorage.getItem('classcms_approval_tab');
                if (savedRole && savedRole !== 'All') {
                    const currentUrl = new URL(window.location.href);
                    currentUrl.searchParams.set('role', savedRole);
                    window.location.replace(currentUrl.toString());
                    return;
                }
            }

            // Approve Confirmation Handler
            const approveModal = new bootstrap.Modal(document.getElementById('approveConfirmModal'));
            const approveForm = document.getElementById('confirmApproveForm');
            const approveName = document.getElementById('modalApproveName');
            const approveRole = document.getElementById('modalApproveRole');

            document.querySelectorAll('.open-approve-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name') || 'this applicant';
                    const role = this.getAttribute('data-role') || 'User';

                    approveName.innerText = name;
                    approveRole.innerText = role;
                    approveForm.action = '@Url.Action("Approve", "UserApproval")/' + id;
                    approveModal.show();
                });
            });

            // Reject Confirmation Handler
            const rejectModal = new bootstrap.Modal(document.getElementById('rejectConfirmModal'));
            const rejectForm = document.getElementById('confirmRejectForm');
            const rejectName = document.getElementById('modalRejectName');

            document.querySelectorAll('.open-reject-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.getAttribute('data-id');
                    const name = this.getAttribute('data-name') || 'this applicant';

                    rejectName.innerText = name;
                    rejectForm.action = '@Url.Action("Reject", "UserApproval")/' + id;
                    rejectModal.show();
                });
            });
        });
    </script>
}
