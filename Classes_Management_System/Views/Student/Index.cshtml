@model CMS_BAL.ViewModels.PagedResult<CMS_BAL.ViewModels.StudentViewModel>
@{
    ViewData["Title"] = "Student Management";
    string currentSearch    = Model.SearchTerm ?? "";
    string currentSortBy    = Model.SortColumn ?? "StudentId";
    string currentSortOrder = Model.SortDirection ?? "DESC";

    var stats = (ViewBag.Stats as CMS_BAL.ViewModels.StudentStatsViewModel)
                ?? new CMS_BAL.ViewModels.StudentStatsViewModel();

    var activeCourses = (ViewBag.ActiveCourses as IEnumerable<CMS_BAL.ViewModels.CourseViewModel>)
                        ?? new List<CMS_BAL.ViewModels.CourseViewModel>();

    var filterBatches = (ViewBag.FilterBatches as IEnumerable<CMS_BAL.ViewModels.BatchViewModel>)
                        ?? new List<CMS_BAL.ViewModels.BatchViewModel>();

    int? currentCourseId = ViewBag.CourseId as int?;
    int? currentBatchId  = ViewBag.BatchId as int?;
    string? currentStatus = ViewBag.StatusFilter as string;
}

<style>
    .stat-metric-card {
        background: #ffffff;
        border: 1px solid rgba(226,232,240,0.8);
        border-radius: 1rem;
        transition: transform 0.25s cubic-bezier(0.16,1,0.3,1), box-shadow 0.25s ease;
        position: relative;
        overflow: hidden;
    }
    .stat-metric-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px -5px rgba(0,0,0,0.08)!important; }
    .stat-metric-card::before { content:''; position:absolute; top:0; left:0; right:0; height:4px; }
    .metric-total::before   { background: linear-gradient(90deg,#3b82f6,#6366f1); }
    .metric-active::before  { background: linear-gradient(90deg,#10b981,#059669); }
    .metric-inactive::before{ background: linear-gradient(90deg,#f59e0b,#d97706); }
    .metric-enrolled::before{ background: linear-gradient(90deg,#8b5cf6,#ec4899); }

    .icon-box { width:52px; height:52px; border-radius:0.85rem; display:flex; align-items:center; justify-content:center; font-size:1.4rem; color:white; box-shadow:0 8px 16px -4px rgba(0,0,0,0.15); }
    .icon-total    { background: linear-gradient(135deg,#3b82f6,#1d4ed8); }
    .icon-active   { background: linear-gradient(135deg,#10b981,#047857); }
    .icon-inactive { background: linear-gradient(135deg,#f59e0b,#b45309); }
    .icon-enrolled { background: linear-gradient(135deg,#8b5cf6,#6d28d9); }

    .hero-banner {
        background: linear-gradient(135deg,#0f172a 0%,#1e293b 50%,#172554 100%);
        border-radius: 1.25rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(15,23,42,0.3);
    }
    .hero-banner::after {
        content:''; position:absolute; top:-50%; right:-20%; width:400px; height:400px;
        background: radial-gradient(circle,rgba(59,130,246,0.15) 0%,rgba(0,0,0,0) 70%);
        border-radius:50%; pointer-events:none;
    }

    .student-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
    }
    .student-card:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0,0,0,0.08)!important; }
    .student-card-header {
        background: linear-gradient(135deg,#f8faff 0%,#eff6ff 100%);
        border-bottom: 1px solid #e2e8f0;
        padding: 1rem 1.25rem 0.75rem;
    }

    .student-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #fff;
        box-shadow: 0 3px 8px rgba(0,0,0,0.12);
    }
    .student-avatar-placeholder {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: linear-gradient(135deg,#3b82f6,#6366f1);
        color: #fff;
        font-weight: 700;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 3px 8px rgba(59,130,246,0.3);
    }

    .status-badge-active   { background:#d1fae5; color:#065f46; border:1px solid #a7f3d0; }
    .status-badge-inactive { background:#fee2e2; color:#991b1b; border:1px solid #fca5a5; }

    .sort-btn { border-radius:2rem!important; font-size:0.8rem; padding:0.3rem 0.8rem; transition:all 0.2s; }
    .sort-btn.active { background:#3b82f6!important; color:#fff!important; border-color:#3b82f6!important; }

    .contact-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
        padding: 0.25rem 0.5rem;
        font-size: 0.76rem;
        color: #475569;
    }
</style>

<!-- Hero Banner -->
<div class="hero-banner p-4 mb-4">
    <div class="row align-items-center g-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center gap-3 mb-2">
                <div style="background:rgba(59,130,246,0.2);border-radius:0.75rem;padding:0.75rem;">
                    <i class="bi bi-people-fill fs-3 text-primary"></i>
                </div>
                <div>
                    <h2 class="text-white fw-bold mb-0">Student Directory</h2>
                    <p class="text-white-50 mb-0 small">Manage student admissions, batch enrollments &amp; profiles</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 text-md-end">
            <a href="@Url.Action("Admission","Student")" class="btn btn-primary btn-sm px-4 py-2 rounded-pill shadow-sm">
                <i class="bi bi-person-plus-fill me-2"></i>New Admission
            </a>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-metric-card metric-total p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-500 mb-1">Total Students</div>
                    <div class="fw-bold fs-4 text-dark">@stats.TotalStudents</div>
                </div>
                <div class="icon-box icon-total"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-metric-card metric-active p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-500 mb-1">Active Students</div>
                    <div class="fw-bold fs-4 text-dark">@stats.ActiveStudents</div>
                </div>
                <div class="icon-box icon-active"><i class="bi bi-person-check"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-metric-card metric-inactive p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-500 mb-1">Inactive Students</div>
                    <div class="fw-bold fs-4 text-dark">@stats.InactiveStudents</div>
                </div>
                <div class="icon-box icon-inactive"><i class="bi bi-person-dash"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-metric-card metric-enrolled p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-500 mb-1">In Batches</div>
                    <div class="fw-bold fs-4 text-dark">@stats.EnrolledStudents</div>
                </div>
                <div class="icon-box icon-enrolled"><i class="bi bi-collection"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Filter / Search Bar -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:1rem;">
    <div class="card-body p-3">
        <form method="get" action="@Url.Action("Index","Student")" id="filterForm">
            <div class="row g-2 align-items-end">
                <!-- Search Input -->
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-bold text-muted mb-1">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" id="searchInput" name="search"
                               value="@currentSearch" placeholder="Name, Admission No, Phone, Parent...">
                        @if (!string.IsNullOrEmpty(currentSearch))
                        {
                            <a href="@Url.Action("Index","Student")" class="btn btn-outline-secondary border-start-0">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>

                <!-- Course Filter (Active Only) -->
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Course</label>
                    <select class="form-select" name="courseId" id="courseFilterSelect" onchange="onCourseFilterChange()">
                        <option value="">All Courses</option>
                        @foreach (var c in activeCourses)
                        {
                            if (currentCourseId == c.CourseId)
                            {
                                <option value="@c.CourseId" selected>@c.CourseName</option>
                            }
                            else
                            {
                                <option value="@c.CourseId">@c.CourseName</option>
                            }
                        }
                    </select>
                </div>

                <!-- Batch Filter (Cascading) -->
                <div class="col-12 col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">Batch</label>
                    <select class="form-select" name="batchId" id="batchFilterSelect" onchange="document.getElementById('filterForm').submit()">
                        <option value="">All Batches</option>
                        @foreach (var b in filterBatches)
                        {
                            if (currentBatchId == b.BatchId)
                            {
                                <option value="@b.BatchId" selected>@b.BatchName</option>
                            }
                            else
                            {
                                <option value="@b.BatchId">@b.BatchName</option>
                            }
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="col-12 col-md-2">
                    <label class="form-label small fw-bold text-muted mb-1">Status</label>
                    <select class="form-select" name="statusFilter" onchange="document.getElementById('filterForm').submit()">
                        <option value="">All Status</option>
                        <!option value="Active" @(currentStatus == "Active" ? "selected" : "")>Active</!option>
                        <!option value="Inactive" @(currentStatus == "Inactive" ? "selected" : "")>Inactive</!option>
                    </select>
                </div>

                <!-- Submit Button -->
                <div class="col-12 col-md-1">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>

                <input type="hidden" name="sortBy"    value="@currentSortBy" />
                <input type="hidden" name="sortOrder" value="@currentSortOrder" />
                <input type="hidden" name="pageSize"  value="@Model.PageSize" />
            </div>

            <!-- Sort Bar -->
            <div class="d-flex flex-wrap gap-2 mt-3">
                <span class="text-muted small align-self-center me-1"><i class="bi bi-sort-down me-1"></i>Sort:</span>
                @{
                    var sortOptions = new[] {
                        ("StudentId", "Newest First", "StudentId", "DESC"),
                        ("FirstName", "Name A-Z", "FirstName", "ASC"),
                        ("AdmissionNo", "Admission No", "AdmissionNo", "ASC"),
                        ("AdmissionDate", "Admission Date", "AdmissionDate", "DESC"),
                        ("CourseName", "By Course", "CourseName", "ASC")
                    };
                    foreach (var (col, label, scol, sdir) in sortOptions)
                    {
                        bool isActive = currentSortBy == scol;
                        <button type="button"
                                class="btn btn-outline-secondary sort-btn @(isActive ? "active" : "")"
                                onclick="setSortAndSubmit('@scol','@sdir')">
                            @label @(isActive ? (currentSortOrder == "ASC" ? "↑" : "↓") : "")
                        </button>
                    }
                }
            </div>
        </form>
    </div>
</div>

<!-- Student Cards Grid -->
@if (!Model.Data.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-people display-1 text-muted opacity-50"></i>
        <h5 class="text-muted mt-3">No students found</h5>
        <p class="text-muted small">
            @if (!string.IsNullOrEmpty(currentSearch) || currentCourseId.HasValue || currentBatchId.HasValue || !string.IsNullOrEmpty(currentStatus))
            {
                <span>No results matched your search or filter criteria.</span>
            }
            else
            {
                <span>Start by admitting your first student into a course &amp; batch.</span>
            }
        </p>
        <a href="@Url.Action("Admission","Student")" class="btn btn-primary btn-sm px-4 rounded-pill mt-2">
            <i class="bi bi-person-plus me-1"></i> Register Student
        </a>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var student in Model.Data)
        {
            string initials = (!string.IsNullOrWhiteSpace(student.FirstName) ? student.FirstName[0].ToString() : "") +
                              (!string.IsNullOrWhiteSpace(student.LastName) ? student.LastName[0].ToString() : "");
            string statusBadgeClass = student.IsActive ? "status-badge-active" : "status-badge-inactive";
            string statusText = student.IsActive ? "Active" : "Inactive";

            <div class="col-12 col-md-6 col-xl-4">
                <div class="student-card shadow-sm h-100 d-flex flex-column">
                    <!-- Card Header -->
                    <div class="student-card-header">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-dark-subtle text-dark border px-2 py-1 rounded-pill" style="font-family: monospace; font-size: 0.72rem;">
                                @student.AdmissionNo
                            </span>
                            <span class="badge rounded-pill px-2 py-1 small @statusBadgeClass">@statusText</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(student.ProfileImage))
                            {
                                <img src="@student.ProfileImage" alt="@student.FullName" class="student-avatar" />
                            }
                            else
                            {
                                <div class="student-avatar-placeholder">@initials</div>
                            }
                            <div class="flex-grow-1 overflow-hidden">
                                <h6 class="fw-bold text-dark mb-0 text-truncate">@student.FullName</h6>
                                <span class="small text-muted" style="font-size:0.75rem;">
                                    <i class="bi bi-calendar-event me-1"></i>Adm: @student.AdmissionDate.ToString("dd MMM yyyy")
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <!-- Course & Batch Pills -->
                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(student.CourseName))
                            {
                                <span class="badge bg-primary-subtle text-primary rounded-pill mb-1 d-inline-block text-truncate" style="max-width:100%;">
                                    <i class="bi bi-mortarboard-fill me-1"></i>@student.CourseName
                                </span>
                            }
                            @if (!string.IsNullOrEmpty(student.BatchName))
                            {
                                <span class="badge bg-success-subtle text-success rounded-pill d-inline-block text-truncate" style="max-width:100%;">
                                    <i class="bi bi-collection-fill me-1"></i>@student.BatchName
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary rounded-pill">
                                    <i class="bi bi-exclamation-circle me-1"></i>No Batch Assigned
                                </span>
                            }
                        </div>

                        <!-- Contact Info -->
                        <div class="d-flex flex-column gap-2 mb-3">
                            <div class="contact-chip">
                                <i class="bi bi-telephone text-primary"></i>
                                <span class="fw-semibold">@(string.IsNullOrEmpty(student.Mobile) ? "—" : student.Mobile)</span>
                            </div>
                            @if (!string.IsNullOrEmpty(student.ParentName) || !string.IsNullOrEmpty(student.ParentMobile))
                            {
                                <div class="contact-chip">
                                    <i class="bi bi-person-heart text-danger"></i>
                                    <span>@(student.ParentName ?? "Parent"): <strong>@(student.ParentMobile ?? "—")</strong></span>
                                </div>
                            }
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 mt-auto pt-2 border-top">
                            <a href="@Url.Action("Details","Student",new{id=student.StudentId})"
                               class="btn btn-sm btn-outline-primary flex-grow-1 rounded-3">
                                <i class="bi bi-eye me-1"></i> View 360°
                            </a>
                            <a href="@Url.Action("Edit","Student",new{id=student.StudentId})"
                               class="btn btn-sm btn-outline-secondary rounded-3" title="Edit Student">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger rounded-3 delete-confirm-btn"
                                    data-url="@Url.Action("Delete","Student",new{id=student.StudentId})"
                                    data-title="Delete Student"
                                    data-name="@student.FullName"
                                    title="Delete Student">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @await Html.PartialAsync("_PaginationBar", new ViewDataDictionary(ViewData)
    {
        ["totalPages"]   = Model.TotalPages,
        ["currentPage"]  = Model.PageNumber,
        ["baseUrl"]      = Url.Action("Index","Student"),
        ["pageSize"]     = Model.PageSize
    })
}

@section Scripts {
<script>
function setSortAndSubmit(col, dir) {
    const form = document.getElementById('filterForm');
    form.querySelector('[name="sortBy"]').value    = col;
    form.querySelector('[name="sortOrder"]').value = dir;
    form.submit();
}

function onCourseFilterChange() {
    const courseId = document.getElementById('courseFilterSelect').value;
    const batchSelect = document.getElementById('batchFilterSelect');

    if (!courseId) {
        batchSelect.innerHTML = '<option value="">All Batches</option>';
        document.getElementById('filterForm').submit();
        return;
    }

    fetch(`/Student/GetBatchesByCourse?courseId=${courseId}`)
        .then(r => r.json())
        .then(batches => {
            let options = '<option value="">All Batches</option>';
            batches.forEach(b => {
                options += `<option value="${b.batchId}">${b.batchName}</option>`;
            });
            batchSelect.innerHTML = options;
            document.getElementById('filterForm').submit();
        })
        .catch(() => {
            document.getElementById('filterForm').submit();
        });
}
</script>
}
