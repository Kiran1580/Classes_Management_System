@model Classes_Management_System.Models.AttendanceIndexViewModel
@{
    ViewData["Title"] = "Attendance Management";
    var isAdmin = User.IsInRole("Admin");
}

<style>
    .stat-metric-card {
        background: #ffffff;
        border: 1px solid rgba(226,232,240,0.8);
        border-radius: 1rem;
        transition: transform 0.25s cubic-bezier(0.16,1,0.3,1), box-shadow 0.25s ease;
        position: relative;
        overflow: hidden;
    }
    .stat-metric-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px -5px rgba(0,0,0,0.08)!important; }
    .stat-metric-card::before { content:''; position:absolute; top:0; left:0; right:0; height:4px; }
    .metric-rate::before    { background: linear-gradient(90deg,#10b981,#059669); }
    .metric-sessions::before{ background: linear-gradient(90deg,#3b82f6,#6366f1); }
    .metric-present::before { background: linear-gradient(90deg,#06b6d4,#0284c7); }
    .metric-absent::before  { background: linear-gradient(90deg,#f43f5e,#e11d48); }

    .icon-box { width:52px; height:52px; border-radius:0.85rem; display:flex; align-items:center; justify-content:center; font-size:1.4rem; color:white; box-shadow:0 8px 16px -4px rgba(0,0,0,0.15); }
    .icon-rate    { background: linear-gradient(135deg,#10b981,#047857); }
    .icon-sessions{ background: linear-gradient(135deg,#3b82f6,#1d4ed8); }
    .icon-present { background: linear-gradient(135deg,#06b6d4,#0284c7); }
    .icon-absent  { background: linear-gradient(135deg,#f43f5e,#be123c); }

    .hero-banner {
        background: linear-gradient(135deg,#0f172a 0%,#1e293b 50%,#172554 100%);
        border-radius: 1.25rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(15,23,42,0.3);
    }
    .hero-banner::after {
        content:''; position:absolute; top:-50%; right:-20%; width:400px; height:400px;
        background: radial-gradient(circle,rgba(59,130,246,0.15) 0%,rgba(0,0,0,0) 70%);
        border-radius:50%; pointer-events:none;
    }

    .sort-btn { border-radius:2rem!important; font-size:0.8rem; padding:0.3rem 0.8rem; transition:all 0.2s; }
    .sort-btn.active { background:#3b82f6!important; color:#fff!important; border-color:#3b82f6!important; }

    .attendance-table th {
        background-color: #f8fafc;
        color: #475569;
        font-weight: 600;
        font-size: 0.82rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        border-bottom: 2px solid #e2e8f0;
        padding: 0.9rem 1rem;
        white-space: nowrap;
    }
    .attendance-table td {
        padding: 0.85rem 1rem;
        vertical-align: middle;
        font-size: 0.9rem;
        border-bottom: 1px solid #f1f5f9;
    }
    .sort-header {
        color: #475569;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
    }
    .sort-header:hover { color: #2563eb; }

    .status-badge-present { background: rgba(16, 185, 129, 0.12); color: #059669; border: 1px solid rgba(16, 185, 129, 0.3); }
    .status-badge-absent  { background: rgba(244, 63, 94, 0.12); color: #e11d48; border: 1px solid rgba(244, 63, 94, 0.3); }
    .status-badge-late    { background: rgba(245, 158, 11, 0.12); color: #d97706; border: 1px solid rgba(245, 158, 11, 0.3); }
    .status-badge-excused { background: rgba(99, 102, 241, 0.12); color: #4f46e5; border: 1px solid rgba(99, 102, 241, 0.3); }
</style>

<div class="container-fluid px-3 px-md-4 py-4">

    <!-- Hero Banner -->
    <div class="hero-banner p-4 mb-4 text-white">
        <div class="row align-items-center g-3">
            <div class="col-md-8">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white"
                         style="width:52px; height:52px; background: rgba(255,255,255,0.15); font-size: 1.6rem; backdrop-filter:blur(8px);">
                        <i class="bi bi-calendar-check text-primary"></i>
                    </div>
                    <div>
                        <h2 class="text-white fw-bold mb-0">Attendance Management</h2>
                        <p class="text-white-50 mb-0 small">Track daily student attendance, session logs &amp; batch metrics</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 text-md-end">
                <div class="d-inline-flex gap-2 flex-wrap justify-content-md-end">
                    <a asp-action="ExportCsv" 
                       asp-route-searchTerm="@Model.SearchTerm"
                       asp-route-batchId="@Model.BatchId"
                       asp-route-courseId="@Model.CourseId"
                       asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-status="@Model.Status"
                       class="btn btn-outline-light btn-sm px-3 py-2 rounded-pill shadow-sm d-inline-flex align-items-center gap-1">
                        <i class="bi bi-download me-1"></i> Export CSV
                    </a>
                    <a asp-action="Mark" 
                       class="btn btn-primary btn-sm px-4 py-2 rounded-pill shadow-sm d-inline-flex align-items-center gap-2"
                       style="background: linear-gradient(135deg, #3b82f6, #6366f1); border: none;">
                        <i class="bi bi-plus-circle me-1"></i> Take Attendance
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="stat-metric-card metric-rate p-3 p-md-4 shadow-sm">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-secondary small fw-medium">Today's Rate</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.Stats.OverallRate%</div>
                    </div>
                    <div class="icon-box icon-rate">
                        <i class="bi bi-pie-chart-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-metric-card metric-sessions p-3 p-md-4 shadow-sm">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-secondary small fw-medium">Sessions Today</div>
                        <div class="fs-3 fw-bold text-dark mt-1">@Model.Stats.SessionsToday</div>
                    </div>
                    <div class="icon-box icon-sessions">
                        <i class="bi bi-collection-play-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-metric-card metric-present p-3 p-md-4 shadow-sm">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-secondary small fw-medium">Present Today</div>
                        <div class="fs-3 fw-bold text-dark mt-1 text-success">@Model.Stats.PresentToday</div>
                    </div>
                    <div class="icon-box icon-present">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-3">
            <div class="stat-metric-card metric-absent p-3 p-md-4 shadow-sm">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-secondary small fw-medium">Absent Today</div>
                        <div class="fs-3 fw-bold text-dark mt-1 text-danger">@Model.Stats.AbsentToday</div>
                    </div>
                    <div class="icon-box icon-absent">
                        <i class="bi bi-person-x-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm mb-4" style="border-radius:1rem;">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" id="filterForm">
                <input type="hidden" name="sortColumn" value="@Model.SortColumn" />
                <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
                <input type="hidden" name="pageNumber" value="1" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />

                <div class="row g-2 align-items-end">
                    <!-- Search Input -->
                    <div class="col-12 col-md-3">
                        <label class="form-label small fw-bold text-muted mb-1">Search</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control border-start-0" id="searchInput" name="searchTerm" 
                                   placeholder="Student name, Roll No, Batch..." value="@Model.SearchTerm" />
                            @if (!string.IsNullOrEmpty(Model.SearchTerm))
                            {
                                <a href="@Url.Action("Index","Attendance")" class="btn btn-outline-secondary border-start-0" title="Clear Search">
                                    <i class="bi bi-x-lg"></i>
                                </a>
                            }
                        </div>
                    </div>

                    <!-- Batch Filter -->
                    <div class="col-12 col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">Batch</label>
                        <select name="batchId" class="form-select" onchange="document.getElementById('filterForm').submit()">
                            <option value="">All Batches</option>
                            @foreach (var b in Model.Batches)
                            {
                                <option value="@b.BatchId" selected="@(Model.BatchId == b.BatchId ? "selected" : null)">
                                    @b.BatchName
                                </option>
                            }
                        </select>
                    </div>

                    <!-- Status Filter -->
                    <div class="col-12 col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">Status</label>
                        <select name="status" class="form-select" onchange="document.getElementById('filterForm').submit()">
                            <option value="">All Statuses</option>
                            <option value="Present" selected="@(Model.Status == "Present" ? "selected" : null)">Present</option>
                            <option value="Absent" selected="@(Model.Status == "Absent" ? "selected" : null)">Absent</option>
                            <option value="Late" selected="@(Model.Status == "Late" ? "selected" : null)">Late</option>
                            <option value="Excused" selected="@(Model.Status == "Excused" ? "selected" : null)">Excused</option>
                        </select>
                    </div>

                    <!-- From Date -->
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">From Date</label>
                        <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" onchange="document.getElementById('filterForm').submit()" />
                    </div>

                    <!-- To Date -->
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-bold text-muted mb-1">To Date</label>
                        <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" onchange="document.getElementById('filterForm').submit()" />
                    </div>

                    <!-- Submit / Search Button -->
                    <div class="col-12 col-md-1">
                        <button type="submit" class="btn btn-primary w-100" title="Apply Filters">
                            <i class="bi bi-funnel"></i>
                        </button>
                    </div>
                </div>

                <!-- Sort Buttons -->
                <div class="d-flex flex-wrap gap-2 mt-3">
                    <span class="text-muted small align-self-center me-1"><i class="bi bi-sort-down me-1"></i>Sort:</span>
                    @{
                        var sortOptions = new[] {
                            ("SessionDate", "Date (Newest)", "SessionDate", "DESC"),
                            ("SessionDateAsc", "Date (Oldest)", "SessionDate", "ASC"),
                            ("StudentName", "Student A-Z", "StudentName", "ASC"),
                            ("BatchName", "By Batch", "BatchName", "ASC"),
                            ("Status", "By Status", "Status", "ASC")
                        };
                        foreach (var (key, label, scol, sdir) in sortOptions)
                        {
                            bool isActive = (Model.SortColumn == scol && Model.SortDirection == sdir);
                            <button type="button"
                                    class="btn btn-outline-secondary sort-btn @(isActive ? "active" : "")"
                                    onclick="setSortAndSubmit('@scol','@sdir')">
                                @label @(isActive ? (Model.SortDirection == "ASC" ? "↑" : "↓") : "")
                            </button>
                        }
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Attendance Grid Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                <i class="bi bi-list-check text-primary"></i> Attendance Records
                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2 py-1 ms-1 small">
                    @Model.TotalCount total
                </span>
            </h5>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge status-badge-present px-2.5 py-1 rounded-pill small">
                    <i class="bi bi-check-circle-fill me-1"></i> Present: @Model.TotalPresent
                </span>
                <span class="badge status-badge-absent px-2.5 py-1 rounded-pill small">
                    <i class="bi bi-x-circle-fill me-1"></i> Absent: @Model.TotalAbsent
                </span>
                <span class="badge status-badge-late px-2.5 py-1 rounded-pill small">
                    <i class="bi bi-clock-fill me-1"></i> Late/Excused: @Model.TotalLate
                </span>
            </div>
        </div>

        @if (Model.Records != null && Model.Records.Any())
        {
            <div class="table-responsive">
                <table class="table attendance-table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>
                                <a href="javascript:void(0)" onclick="setSortAndSubmit('SessionDate', '@(Model.SortColumn == "SessionDate" && Model.SortDirection == "DESC" ? "ASC" : "DESC")')" class="sort-header">
                                    Date
                                    @if (Model.SortColumn == "SessionDate") {
                                        <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down") text-primary"></i>
                                    }
                                </a>
                            </th>
                            <th>
                                <a href="javascript:void(0)" onclick="setSortAndSubmit('StudentName', '@(Model.SortColumn == "StudentName" && Model.SortDirection == "ASC" ? "DESC" : "ASC")')" class="sort-header">
                                    Student Name
                                    @if (Model.SortColumn == "StudentName") {
                                        <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down") text-primary"></i>
                                    }
                                </a>
                            </th>
                            <th>Roll / Adm No</th>
                            <th>
                                <a href="javascript:void(0)" onclick="setSortAndSubmit('BatchName', '@(Model.SortColumn == "BatchName" && Model.SortDirection == "ASC" ? "DESC" : "ASC")')" class="sort-header">
                                    Batch & Course
                                    @if (Model.SortColumn == "BatchName") {
                                        <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down") text-primary"></i>
                                    }
                                </a>
                            </th>
                            <th>Subject / Faculty</th>
                            <th>
                                <a href="javascript:void(0)" onclick="setSortAndSubmit('Status', '@(Model.SortColumn == "Status" && Model.SortDirection == "ASC" ? "DESC" : "ASC")')" class="sort-header">
                                    Status
                                    @if (Model.SortColumn == "Status") {
                                        <i class="bi bi-arrow-@(Model.SortDirection == "ASC" ? "up" : "down") text-primary"></i>
                                    }
                                </a>
                            </th>
                            <th>Remarks / Topic</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Records)
                        {
                            <tr>
                                <td class="fw-medium text-dark">
                                    <i class="bi bi-calendar3 me-1 text-secondary"></i> @row.SessionDate.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(row.ProfileImage))
                                        {
                                            <img src="@row.ProfileImage" class="rounded-circle border" style="width: 32px; height: 32px; object-fit: cover;" alt="@row.StudentName" />
                                        }
                                        else
                                        {
                                            <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-bold" style="width: 32px; height: 32px; font-size: 0.8rem;">
                                                @(string.IsNullOrEmpty(row.StudentName) ? "S" : row.StudentName[0].ToString().ToUpper())
                                            </div>
                                        }
                                        <span class="fw-semibold text-dark">@row.StudentName</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border font-monospace">@row.AdmissionNo</span>
                                </td>
                                <td>
                                    <div class="fw-medium text-dark">@row.BatchName</div>
                                    <small class="text-muted">@row.CourseName</small>
                                </td>
                                <td>
                                    <div class="small fw-medium text-dark">@row.SubjectName</div>
                                    <small class="text-secondary"><i class="bi bi-person me-1"></i>@row.TeacherName</small>
                                </td>
                                <td>
                                    @if (row.Status == "Present")
                                    {
                                        <span class="badge status-badge-present px-2.5 py-1 rounded-pill">
                                            <i class="bi bi-check-circle-fill me-1"></i> Present
                                        </span>
                                    }
                                    else if (row.Status == "Absent")
                                    {
                                        <span class="badge status-badge-absent px-2.5 py-1 rounded-pill">
                                            <i class="bi bi-x-circle-fill me-1"></i> Absent
                                        </span>
                                    }
                                    else if (row.Status == "Late")
                                    {
                                        <span class="badge status-badge-late px-2.5 py-1 rounded-pill">
                                            <i class="bi bi-clock-fill me-1"></i> Late
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge status-badge-excused px-2.5 py-1 rounded-pill">
                                            <i class="bi bi-info-circle-fill me-1"></i> @row.Status
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(row.Remarks))
                                    {
                                        <span class="text-dark small d-block">@row.Remarks</span>
                                    }
                                    @if (!string.IsNullOrEmpty(row.Topic))
                                    {
                                        <small class="text-muted"><i class="bi bi-book me-1"></i>@row.Topic</small>
                                    }
                                    @if (string.IsNullOrEmpty(row.Remarks) && string.IsNullOrEmpty(row.Topic))
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Mark" 
                                       asp-route-batchId="@row.BatchId" 
                                       asp-route-sessionDate="@row.SessionDate.ToString("yyyy-MM-dd")" 
                                       class="btn btn-sm btn-outline-primary px-3 rounded-2 fw-semibold d-inline-flex align-items-center gap-1 shadow-sm"
                                       style="font-size: 0.78rem;"
                                       title="Edit Session Attendance">
                                        <i class="bi bi-pencil-square me-1"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Footer -->
            @if (Model.TotalCount > 0)
            {
                <div class="card-footer bg-white border-top py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                    <div class="text-secondary small">
                        Showing <strong class="text-dark">@(((Model.PageNumber - 1) * Model.PageSize) + 1)</strong> to <strong class="text-dark">@(Math.Min(Model.PageNumber * Model.PageSize, Model.TotalCount))</strong> of <strong class="text-dark">@Model.TotalCount</strong> records
                    </div>

                    <div class="d-flex align-items-center gap-3 flex-wrap justify-content-center justify-content-md-end">
                        <div class="d-flex align-items-center gap-2">
                            <span class="small text-muted fw-semibold text-nowrap">Rows per page:</span>
                            <select class="form-select form-select-sm" style="width: 78px;" onchange="location.href='@Url.Action("Index", new { 
                                searchTerm = Model.SearchTerm, batchId = Model.BatchId, courseId = Model.CourseId, 
                                fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), status = Model.Status, 
                                sortColumn = Model.SortColumn, sortDirection = Model.SortDirection, pageNumber = 1 
                            })&pageSize=' + this.value">
                                @foreach (var size in new[] { 10, 20, 50, 100 })
                                {
                                    <option value="@size" selected="@(Model.PageSize == size ? "selected" : null)">@size</option>
                                }
                            </select>
                        </div>

                        <div class="small text-muted fw-medium text-nowrap">
                            Page <strong class="text-dark">@Model.PageNumber</strong> of <strong class="text-dark">@Model.TotalPages</strong>
                        </div>

                        <nav aria-label="Pagination">
                            <ul class="pagination pagination-sm mb-0 align-items-center" style="gap: 3px;">
                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { 
                                        searchTerm = Model.SearchTerm, batchId = Model.BatchId, courseId = Model.CourseId, 
                                        fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), status = Model.Status, 
                                        sortColumn = Model.SortColumn, sortDirection = Model.SortDirection, pageNumber = 1, pageSize = Model.PageSize 
                                    })" title="First"><i class="bi bi-chevron-double-left"></i></a>
                                </li>

                                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { 
                                        searchTerm = Model.SearchTerm, batchId = Model.BatchId, courseId = Model.CourseId, 
                                        fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), status = Model.Status, 
                                        sortColumn = Model.SortColumn, sortDirection = Model.SortDirection, pageNumber = Model.PageNumber - 1, pageSize = Model.PageSize 
                                    })" title="Previous"><i class="bi bi-chevron-left"></i></a>
                                </li>

                                @{
                                    int startPage = Math.Max(1, Model.PageNumber - 2);
                                    int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                                }
                                @for (int p = startPage; p <= endPage; p++)
                                {
                                    <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("Index", new { 
                                            searchTerm = Model.SearchTerm, batchId = Model.BatchId, courseId = Model.CourseId, 
                                            fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), status = Model.Status, 
                                            sortColumn = Model.SortColumn, sortDirection = Model.SortDirection, pageNumber = p, pageSize = Model.PageSize 
                                        })">@p</a>
                                    </li>
                                }

                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { 
                                        searchTerm = Model.SearchTerm, batchId = Model.BatchId, courseId = Model.CourseId, 
                                        fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), status = Model.Status, 
                                        sortColumn = Model.SortColumn, sortDirection = Model.SortDirection, pageNumber = Model.PageNumber + 1, pageSize = Model.PageSize 
                                    })" title="Next"><i class="bi bi-chevron-right"></i></a>
                                </li>

                                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("Index", new { 
                                        searchTerm = Model.SearchTerm, batchId = Model.BatchId, courseId = Model.CourseId, 
                                        fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), status = Model.Status, 
                                        sortColumn = Model.SortColumn, sortDirection = Model.SortDirection, pageNumber = Model.TotalPages, pageSize = Model.PageSize 
                                    })" title="Last"><i class="bi bi-chevron-double-right"></i></a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x display-1 text-muted opacity-50"></i>
                <h5 class="text-muted mt-3">No attendance records found</h5>
                <p class="text-muted small">
                    @if (!string.IsNullOrEmpty(Model.SearchTerm) || Model.BatchId.HasValue || !string.IsNullOrEmpty(Model.Status) || Model.FromDate.HasValue || Model.ToDate.HasValue)
                    {
                        <span>No records matched your search or filter criteria. Try clearing filters.</span>
                    }
                    else
                    {
                        <span>Start by recording student attendance for your active batches.</span>
                    }
                </p>
                <a asp-action="Mark" class="btn btn-primary btn-sm px-4 rounded-pill mt-2 shadow-sm" style="background: linear-gradient(135deg, #3b82f6, #6366f1); border: none;">
                    <i class="bi bi-plus-circle me-1"></i> Take Attendance Now
                </a>
            </div>
        }
    </div>

</div>

@section Scripts {
<script>
    function setSortAndSubmit(col, dir) {
        const form = document.getElementById('filterForm');
        if (form) {
            const colInput = form.querySelector('[name="sortColumn"]');
            const dirInput = form.querySelector('[name="sortDirection"]');
            if (colInput) colInput.value = col;
            if (dirInput) dirInput.value = dir;
            form.submit();
        }
    }
</script>
}
