@model Classes_Management_System.Models.StudentAttendanceViewModel
@{
    ViewData["Title"] = "My Attendance";
}

<style>
    .student-att-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #312e81 100%);
        border-radius: 1.25rem;
        box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.4);
    }
    .metric-card {
        background: #ffffff;
        border: 1px solid rgba(226,232,240,0.8);
        border-radius: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .metric-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.06);
    }
    .percentage-circle {
        width: 110px;
        height: 110px;
        border-radius: 50%;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 16px rgba(0,0,0,0.1);
    }
    .circle-eligible {
        background: linear-gradient(135deg, #10b981, #047857);
        color: white;
    }
    .circle-warning {
        background: linear-gradient(135deg, #ef4444, #b91c1c);
        color: white;
    }

    .status-badge-present { background: rgba(16, 185, 129, 0.12); color: #059669; border: 1px solid rgba(16, 185, 129, 0.3); }
    .status-badge-absent  { background: rgba(244, 63, 94, 0.12); color: #e11d48; border: 1px solid rgba(244, 63, 94, 0.3); }
    .status-badge-late    { background: rgba(245, 158, 11, 0.12); color: #d97706; border: 1px solid rgba(245, 158, 11, 0.3); }
</style>

<div class="container-fluid px-3 px-md-4 py-4">

    <!-- Hero Header -->
    <div class="student-att-hero p-4 p-md-5 mb-4 text-white">
        <div class="row align-items-center">
            <div class="col-lg-8 mb-3 mb-lg-0">
                <span class="badge px-3 py-1 rounded-pill mb-2 fw-semibold" style="background: rgba(255, 255, 255, 0.18) !important; color: #ffffff !important; border: 1px solid rgba(255, 255, 255, 0.3) !important; font-size: 0.8rem;">
                    <i class="bi bi-mortarboard-fill me-1"></i> Student Portal
                </span>
                <h2 class="fw-bold mb-1">My Attendance Tracker</h2>
                <p class="text-light text-opacity-75 mb-0">
                    Hello, <b class="text-white">@Model.StudentName</b> (Adm: @Model.AdmissionNo)! Track your class attendance and maintain required attendance percentages.
                </p>
            </div>
            <div class="col-lg-4 text-lg-end">
                <div class="d-inline-flex align-items-center gap-3 p-3 rounded-4" style="background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.25);">
                    <div class="percentage-circle @(Model.IsEligible ? "circle-eligible" : "circle-warning")">
                        <span class="fs-4 fw-bold">@Model.AttendancePercentage%</span>
                        <small style="font-size: 0.65rem; text-transform: uppercase;">Overall</small>
                    </div>
                    <div class="text-start">
                        @if (Model.IsEligible)
                        {
                            <span class="badge bg-success px-2 py-1 mb-1"><i class="bi bi-check-circle-fill me-1"></i> Eligible</span>
                            <div class="small text-white text-opacity-75">Good standing (>= 75%)</div>
                        }
                        else
                        {
                            <span class="badge bg-danger px-2 py-1 mb-1"><i class="bi bi-exclamation-triangle-fill me-1"></i> Warning</span>
                            <div class="small text-danger-subtle fw-semibold">Attendance below 75%</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Metric Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="metric-card p-3 p-md-4 shadow-sm text-center">
                <div class="text-secondary small fw-medium">Total Classes</div>
                <div class="fs-3 fw-bold text-dark mt-1">@Model.TotalClasses</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="metric-card p-3 p-md-4 shadow-sm text-center">
                <div class="text-secondary small fw-medium">Attended</div>
                <div class="fs-3 fw-bold text-success mt-1">@Model.AttendedClasses</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="metric-card p-3 p-md-4 shadow-sm text-center">
                <div class="text-secondary small fw-medium">Absent</div>
                <div class="fs-3 fw-bold text-danger mt-1">@Model.AbsentClasses</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="metric-card p-3 p-md-4 shadow-sm text-center">
                <div class="text-secondary small fw-medium">Late / Excused</div>
                <div class="fs-3 fw-bold text-warning mt-1">@Model.LateClasses</div>
            </div>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="MyAttendance">
                <input type="hidden" name="sortColumn" value="@Model.SortColumn" />
                <input type="hidden" name="sortDirection" value="@Model.SortDirection" />
                <input type="hidden" name="pageNumber" value="1" />

                <div class="row g-3 align-items-end">
                    <div class="col-12 col-md-4">
                        <label class="form-label small fw-semibold text-secondary">Status Filter</label>
                        <select name="status" class="form-select">
                            <option value="">All Statuses</option>
                            <option value="Present" selected="@(Model.Status == "Present" ? "selected" : null)">Present</option>
                            <option value="Absent" selected="@(Model.Status == "Absent" ? "selected" : null)">Absent</option>
                            <option value="Late" selected="@(Model.Status == "Late" ? "selected" : null)">Late</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold text-secondary">From Date</label>
                        <input type="date" name="fromDate" class="form-control" value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-6 col-md-3">
                        <label class="form-label small fw-semibold text-secondary">To Date</label>
                        <input type="date" name="toDate" class="form-control" value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-funnel-fill me-1"></i> Filter
                        </button>
                        <a asp-action="MyAttendance" class="btn btn-light border text-muted">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Log Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center justify-content-between">
            <h5 class="mb-0 fw-bold text-dark d-flex align-items-center gap-2">
                <i class="bi bi-calendar-check text-primary"></i> Attendance Log History
                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-2 py-1 ms-1 small">
                    @Model.TotalCount records
                </span>
            </h5>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary small text-uppercase">
                    <tr>
                        <th>Date</th>
                        <th>Batch & Subject</th>
                        <th>Faculty</th>
                        <th>Status</th>
                        <th>Topic Covered</th>
                        <th>Remarks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Records != null && Model.Records.Any())
                    {
                        foreach (var row in Model.Records)
                        {
                            <tr>
                                <td class="fw-semibold text-dark">
                                    <i class="bi bi-calendar3 me-1 text-secondary"></i> @row.SessionDate.ToString("dd MMM yyyy")
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@row.BatchName</div>
                                    <small class="text-muted">@row.SubjectName</small>
                                </td>
                                <td>
                                    <span class="small text-secondary"><i class="bi bi-person me-1"></i>@row.TeacherName</span>
                                </td>
                                <td>
                                    @if (row.Status == "Present")
                                    {
                                        <span class="badge status-badge-present px-2 py-1 rounded-pill">
                                            <i class="bi bi-check-circle-fill me-1"></i> Present
                                        </span>
                                    }
                                    else if (row.Status == "Absent")
                                    {
                                        <span class="badge status-badge-absent px-2 py-1 rounded-pill">
                                            <i class="bi bi-x-circle-fill me-1"></i> Absent
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge status-badge-late px-2 py-1 rounded-pill">
                                            <i class="bi bi-clock-fill me-1"></i> Late
                                        </span>
                                    }
                                </td>
                                <td>
                                    <small class="text-dark">@(string.IsNullOrEmpty(row.Topic) ? "—" : row.Topic)</small>
                                </td>
                                <td>
                                    <small class="text-muted">@(string.IsNullOrEmpty(row.Remarks) ? "—" : row.Remarks)</small>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                                <h6 class="mt-3 text-secondary fw-semibold">No attendance records found</h6>
                                <p class="text-muted small">Your attendance records will appear here as classes are conducted.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top py-3 px-4 d-flex justify-content-between align-items-center">
                <div class="text-muted small">
                    Page @Model.PageNumber of @Model.TotalPages
                </div>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("MyAttendance", new { fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), status = Model.Status, pageNumber = Model.PageNumber - 1 })">&laquo; Prev</a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                <a class="page-link" href="@Url.Action("MyAttendance", new { fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), status = Model.Status, pageNumber = p })">@p</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" href="@Url.Action("MyAttendance", new { fromDate = Model.FromDate?.ToString("yyyy-MM-dd"), toDate = Model.ToDate?.ToString("yyyy-MM-dd"), status = Model.Status, pageNumber = Model.PageNumber + 1 })">Next &raquo;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>

</div>
