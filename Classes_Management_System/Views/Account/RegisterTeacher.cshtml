@model CMS_BAL.ViewModels.TeacherRegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Faculty Registration - Classes Management System";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        * {
            box-sizing: border-box;
        }
        body {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            color: #f8fafc;
            margin: 0;
            padding: 1.5rem 1rem;
        }
        .register-card {
            background: #1e293b;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 1.25rem;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6);
            width: 100%;
            max-width: 520px;
            padding: 2.25rem;
        }
        @@media (max-width: 576px) {
            .register-card {
                padding: 1.5rem 1.25rem;
                border-radius: 1rem;
            }
        }
        .brand-badge {
            width: 58px;
            height: 58px;
            background: linear-gradient(135deg, #f59e0b, #d97706);
            border-radius: 1rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 1.75rem;
            color: white;
            box-shadow: 0 10px 25px -5px rgba(245, 158, 11, 0.5);
        }
        .field-label {
            color: #cbd5e1;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            margin-bottom: 0.35rem;
            display: block;
        }
        .custom-input-group {
            display: flex;
            align-items: center;
            background: #ffffff;
            border: 1.5px solid #cbd5e1;
            border-radius: 0.75rem;
            overflow: hidden;
            transition: all 0.2s ease;
        }
        .custom-input-group:focus-within {
            border-color: #f59e0b;
            box-shadow: 0 0 0 3.5px rgba(245, 158, 11, 0.25);
        }
        .custom-input-group .input-icon {
            padding: 0.7rem 0.25rem 0.7rem 1rem;
            color: #64748b;
            font-size: 1.05rem;
            display: flex;
            align-items: center;
            justify-content: center;
            background: transparent;
        }
        .custom-input-group input.custom-control {
            flex: 1;
            border: none;
            outline: none;
            background: #ffffff;
            color: #0f172a;
            font-size: 0.92rem;
            font-weight: 500;
            padding: 0.7rem 0.85rem;
        }
        .custom-input-group input.custom-control::placeholder {
            color: #94a3b8;
            font-weight: 400;
        }
        .custom-input-group .eye-toggle-btn {
            background: transparent;
            border: none;
            outline: none;
            padding: 0.7rem 1rem 0.7rem 0.5rem;
            color: #64748b;
            font-size: 1.15rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.15s ease;
        }
        .custom-input-group .eye-toggle-btn:hover {
            color: #0f172a;
        }
        .custom-input-group input:-webkit-autofill,
        .custom-input-group input:-webkit-autofill:hover,
        .custom-input-group input:-webkit-autofill:focus {
            -webkit-box-shadow: 0 0 0px 1000px #ffffff inset !important;
            -webkit-text-fill-color: #0f172a !important;
        }
        .btn-register {
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            border: none;
            color: #ffffff;
            padding: 0.85rem;
            border-radius: 0.75rem;
            font-weight: 600;
            font-size: 0.95rem;
            letter-spacing: 0.02em;
            box-shadow: 0 10px 15px -3px rgba(245, 158, 11, 0.4);
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }
        .btn-register:hover {
            transform: translateY(-1px);
            box-shadow: 0 15px 20px -3px rgba(245, 158, 11, 0.6);
            color: #ffffff;
        }
        .info-pill {
            background: rgba(245, 158, 11, 0.12);
            border: 1px solid rgba(245, 158, 11, 0.3);
            border-radius: 0.75rem;
            padding: 0.75rem 1rem;
            font-size: 0.8rem;
            color: #fde68a;
        }
    </style>
</head>
<body>
    <div class="register-card">
        <div class="text-center mb-4">
            <div class="brand-badge mb-3">
                <i class="bi bi-person-video3"></i>
            </div>
            <span class="badge bg-warning-subtle text-warning px-3 py-1 rounded-pill fw-semibold mb-2" style="font-size: 0.75rem;">
                Faculty Portal
            </span>
            <h3 class="fw-bold text-white mb-1">Faculty Registration</h3>
            <p class="text-light text-opacity-75 small mb-0">Apply to join as teacher/instructor</p>
        </div>

        @if (ViewData.ModelState.TryGetValue(string.Empty, out var modelErrors) && modelErrors.Errors.Count > 0)
        {
            <div class="alert alert-danger py-2 px-3 small rounded-3 mb-3 d-flex align-items-center gap-2" role="alert">
                <i class="bi bi-exclamation-triangle-fill flex-shrink-0"></i>
                <div>
                    @foreach (var err in modelErrors.Errors)
                    {
                        <div>@err.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <div class="info-pill mb-3 d-flex align-items-start gap-2">
            <i class="bi bi-shield-check fs-5 text-warning mt-n1"></i>
            <div>
                <strong>Verification Required:</strong> Your application will be reviewed and approved by an Administrator before portal access is granted.
            </div>
        </div>

        <form asp-controller="Account" asp-action="RegisterTeacher" method="post">
            @Html.AntiForgeryToken()

            <!-- Full Name -->
            <div class="mb-3">
                <label class="field-label">Teacher / Faculty Full Name *</label>
                <div class="custom-input-group">
                    <div class="input-icon">
                        <i class="bi bi-person"></i>
                    </div>
                    <input asp-for="FullName" class="custom-control" placeholder="e.g. Dr. Priya Verma" autofocus />
                </div>
                <span asp-validation-for="FullName" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Email & Mobile row -->
            <div class="row g-2 mb-3">
                <div class="col-12 col-sm-6">
                    <label class="field-label">Email Address *</label>
                    <div class="custom-input-group">
                        <div class="input-icon">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <input asp-for="Email" class="custom-control" placeholder="priya@institute.com" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label class="field-label">Mobile Number *</label>
                    <div class="custom-input-group">
                        <div class="input-icon">
                            <i class="bi bi-phone"></i>
                        </div>
                        <input asp-for="Mobile" class="custom-control" placeholder="10-digit mobile" maxlength="10" />
                    </div>
                    <span asp-validation-for="Mobile" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <!-- Qualification & Specialization -->
            <div class="row g-2 mb-3">
                <div class="col-12 col-sm-6">
                    <label class="field-label">Highest Qualification *</label>
                    <div class="custom-input-group">
                        <div class="input-icon">
                            <i class="bi bi-award"></i>
                        </div>
                        <input asp-for="Qualification" class="custom-control" placeholder="M.Sc / B.Tech / Ph.D" />
                    </div>
                    <span asp-validation-for="Qualification" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label class="field-label">Subject Specialization *</label>
                    <div class="custom-input-group">
                        <div class="input-icon">
                            <i class="bi bi-journal-bookmark"></i>
                        </div>
                        <input asp-for="SubjectSpecialization" class="custom-control" placeholder="Maths / Physics / etc" />
                    </div>
                    <span asp-validation-for="SubjectSpecialization" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <!-- Password & Confirm Password -->
            <div class="row g-2 mb-4">
                <div class="col-12 col-sm-6">
                    <label class="field-label">Password *</label>
                    <div class="custom-input-group">
                        <div class="input-icon">
                            <i class="bi bi-lock"></i>
                        </div>
                        <input asp-for="Password" id="passwordInput" type="password" class="custom-control" placeholder="Min 6 chars" />
                        <button class="eye-toggle-btn" type="button" id="togglePasswordBtn" title="Toggle password">
                            <i class="bi bi-eye" id="togglePasswordIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>
                <div class="col-12 col-sm-6">
                    <label class="field-label">Confirm Password *</label>
                    <div class="custom-input-group">
                        <div class="input-icon">
                            <i class="bi bi-shield-check"></i>
                        </div>
                        <input asp-for="ConfirmPassword" id="confirmPasswordInput" type="password" class="custom-control" placeholder="Re-enter" />
                        <button class="eye-toggle-btn" type="button" id="toggleConfirmBtn" title="Toggle password">
                            <i class="bi bi-eye" id="toggleConfirmIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn btn-register w-100 mb-3">
                <i class="bi bi-person-check-fill me-1"></i> Register as Faculty
            </button>

            <!-- Links -->
            <div class="text-center pt-2 border-top border-secondary border-opacity-25">
                <div class="mb-2">
                    <span class="text-light text-opacity-75 small">Already have an account?</span>
                    <a asp-action="Login" class="text-info text-decoration-none fw-semibold small ms-1">
                        Sign In here <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div>
                    <span class="text-light text-opacity-75 small">Are you a Student?</span>
                    <a asp-action="RegisterStudent" class="text-primary text-decoration-none fw-semibold small ms-1">
                        Student Registration <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
        </form>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            function setupEyeToggle(btnId, inputId, iconId) {
                const btn = document.getElementById(btnId);
                const input = document.getElementById(inputId);
                const icon = document.getElementById(iconId);

                if (btn && input && icon) {
                    btn.addEventListener('click', function () {
                        const isPassword = input.getAttribute('type') === 'password';
                        input.setAttribute('type', isPassword ? 'text' : 'password');
                        icon.classList.toggle('bi-eye', !isPassword);
                        icon.classList.toggle('bi-eye-slash', isPassword);
                    });
                }
            }

            setupEyeToggle('togglePasswordBtn', 'passwordInput', 'togglePasswordIcon');
            setupEyeToggle('toggleConfirmBtn', 'confirmPasswordInput', 'toggleConfirmIcon');
        });
    </script>
</body>
</html>
