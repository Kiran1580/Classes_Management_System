@model CMS_BAL.ViewModels.PagedResult<CMS_BAL.ViewModels.BatchViewModel>
@{
    ViewData["Title"] = "Batch Management";
    string currentSearch   = Model.SearchTerm ?? "";
    string currentSortBy   = Model.SortColumn ?? "BatchId";
    string currentSortOrder = Model.SortDirection ?? "DESC";
    var allCourses = (ViewBag.AllCourses as IEnumerable<CMS_BAL.ViewModels.CourseViewModel>)
                     ?? new List<CMS_BAL.ViewModels.CourseViewModel>();
    var activeCourses = (ViewBag.ActiveCourses as IEnumerable<CMS_BAL.ViewModels.CourseViewModel>)
                        ?? new List<CMS_BAL.ViewModels.CourseViewModel>();
    int? currentCourseFilter = ViewBag.CourseFilter as int?;
    string? currentStatusFilter = ViewBag.StatusFilter as string;

    int totalBatches    = ViewBag.TotalBatches    ?? Model.TotalCount;
    int activeBatches   = ViewBag.ActiveBatches   ?? 0;
    int inactiveBatches = ViewBag.InactiveBatches ?? 0;
    int totalEnrolled   = ViewBag.TotalEnrolled   ?? 0;
}

<style>
    .stat-metric-card {
        background: #ffffff;
        border: 1px solid rgba(226,232,240,0.8);
        border-radius: 1rem;
        transition: transform 0.25s cubic-bezier(0.16,1,0.3,1), box-shadow 0.25s ease;
        position: relative;
        overflow: hidden;
    }
    .stat-metric-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px -5px rgba(0,0,0,0.08)!important; }
    .stat-metric-card::before { content:''; position:absolute; top:0; left:0; right:0; height:4px; }
    .metric-total::before   { background: linear-gradient(90deg,#3b82f6,#6366f1); }
    .metric-active::before  { background: linear-gradient(90deg,#10b981,#059669); }
    .metric-inactive::before{ background: linear-gradient(90deg,#f59e0b,#d97706); }
    .metric-enrolled::before{ background: linear-gradient(90deg,#8b5cf6,#ec4899); }

    .icon-box { width:52px; height:52px; border-radius:0.85rem; display:flex; align-items:center; justify-content:center; font-size:1.4rem; color:white; box-shadow:0 8px 16px -4px rgba(0,0,0,0.15); }
    .icon-total    { background: linear-gradient(135deg,#3b82f6,#1d4ed8); }
    .icon-active   { background: linear-gradient(135deg,#10b981,#047857); }
    .icon-inactive { background: linear-gradient(135deg,#f59e0b,#b45309); }
    .icon-enrolled { background: linear-gradient(135deg,#8b5cf6,#6d28d9); }

    .hero-banner {
        background: linear-gradient(135deg,#0f172a 0%,#1e293b 50%,#172554 100%);
        border-radius: 1.25rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(15,23,42,0.3);
    }
    .hero-banner::after {
        content:''; position:absolute; top:-50%; right:-20%; width:400px; height:400px;
        background: radial-gradient(circle,rgba(59,130,246,0.15) 0%,rgba(0,0,0,0) 70%);
        border-radius:50%; pointer-events:none;
    }

    .batch-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
    }
    .batch-card:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0,0,0,0.08)!important; }
    .batch-card-header {
        background: linear-gradient(135deg,#f8faff 0%,#eff6ff 100%);
        border-bottom: 1px solid #e2e8f0;
        padding: 1rem 1.25rem 0.75rem;
    }

    .status-badge-active   { background:#d1fae5; color:#065f46; border:1px solid #a7f3d0; }
    .status-badge-inactive { background:#fee2e2; color:#991b1b; border:1px solid #fca5a5; }
    .status-badge-completed{ background:#dbeafe; color:#1e40af; border:1px solid #93c5fd; }

    .sort-btn { border-radius:2rem!important; font-size:0.8rem; padding:0.3rem 0.8rem; transition:all 0.2s; }
    .sort-btn.active { background:#3b82f6!important; color:#fff!important; border-color:#3b82f6!important; }

    .filter-chip {
        display:inline-flex; align-items:center; gap:0.35rem;
        padding:0.25rem 0.65rem; border-radius:2rem; font-size:0.78rem; font-weight:500;
        background:#eff6ff; color:#1d4ed8; border:1px solid #bfdbfe; cursor:pointer;
        transition:all 0.2s;
    }
    .filter-chip:hover  { background:#dbeafe; }
    .filter-chip.active { background:#3b82f6; color:#fff; border-color:#3b82f6; }

    .time-pill {
        background:#f1f5f9; border-radius:0.5rem; padding:0.2rem 0.5rem;
        font-size:0.78rem; font-weight:600; color:#475569; font-family:monospace;
    }
    .capacity-bar { height:6px; border-radius:3px; background:#e2e8f0; overflow:hidden; }
    .capacity-fill { height:100%; border-radius:3px; background:linear-gradient(90deg,#3b82f6,#6366f1); transition:width 0.4s; }
    .capacity-fill.warning { background:linear-gradient(90deg,#f59e0b,#d97706); }
    .capacity-fill.danger  { background:linear-gradient(90deg,#ef4444,#dc2626); }
</style>

<!-- Hero Banner -->
<div class="hero-banner p-4 mb-4">
    <div class="row align-items-center g-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center gap-3 mb-2">
                <div style="background:rgba(59,130,246,0.2);border-radius:0.75rem;padding:0.75rem;">
                    <i class="bi bi-collection fs-3 text-primary"></i>
                </div>
                <div>
                    <h2 class="text-white fw-bold mb-0">Batch Management</h2>
                    <p class="text-white-50 mb-0 small">Manage all batches — schedules, capacity & status</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 text-md-end">
            <button class="btn btn-primary btn-sm px-4 py-2 rounded-pill"
                    data-bs-toggle="modal" data-bs-target="#addBatchModal">
                <i class="bi bi-plus-circle me-2"></i>Add New Batch
            </button>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-metric-card metric-total p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-500 mb-1">Total Batches</div>
                    <div class="fw-bold fs-4 text-dark">@totalBatches</div>
                </div>
                <div class="icon-box icon-total"><i class="bi bi-collection"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-metric-card metric-active p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-500 mb-1">Active Batches</div>
                    <div class="fw-bold fs-4 text-dark">@activeBatches</div>
                </div>
                <div class="icon-box icon-active"><i class="bi bi-check-circle"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-metric-card metric-inactive p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-500 mb-1">Inactive Batches</div>
                    <div class="fw-bold fs-4 text-dark">@inactiveBatches</div>
                </div>
                <div class="icon-box icon-inactive"><i class="bi bi-pause-circle"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-metric-card metric-enrolled p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-500 mb-1">Total Enrolled</div>
                    <div class="fw-bold fs-4 text-dark">@totalEnrolled</div>
                </div>
                <div class="icon-box icon-enrolled"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Search / Sort / Filter Bar -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:1rem;">
    <div class="card-body p-3">
        <form method="get" action="@Url.Action("Index","Batch")" id="filterForm">
            <div class="row g-2 align-items-end">
                <!-- Search -->
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-bold text-muted mb-1">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" id="searchInput" name="search"
                               value="@currentSearch" placeholder="Search batches, courses...">
                        @if (!string.IsNullOrEmpty(currentSearch))
                        {
                            <a href="@Url.Action("Index","Batch")" class="btn btn-outline-secondary border-start-0">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>

                <!-- Course Filter (Active Courses Only) -->
                <div class="col-12 col-md-4">
                    <label class="form-label small fw-bold text-muted mb-1">Course</label>
                    <select class="form-select" name="courseFilter" onchange="document.getElementById('filterForm').submit()">
                        <option value="">All Courses</option>
                        @foreach (var c in activeCourses)
                        {
                            if (currentCourseFilter == c.CourseId)
                            {
                                <option value="@c.CourseId" selected>@c.CourseName</option>
                            }
                            else
                            {
                                <option value="@c.CourseId">@c.CourseName</option>
                            }
                        }
                    </select>
                </div>

                <!-- Status Filter -->
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Status</label>
                    <select class="form-select" name="statusFilter" onchange="document.getElementById('filterForm').submit()">
                        <option value="">All Status</option>
                        <!option value="Active" @(currentStatusFilter == "Active" ? "selected" : "")>Active</!option>
                        <!option value="Inactive" @(currentStatusFilter == "Inactive" ? "selected" : "")>Inactive</!option>
                        <!option value="Completed" @(currentStatusFilter == "Completed" ? "selected" : "")>Completed</!option>
                    </select>
                </div>

                <!-- Search Button -->
                <div class="col-12 col-md-1">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>

                <input type="hidden" name="sortBy"    value="@currentSortBy" />
                <input type="hidden" name="sortOrder" value="@currentSortOrder" />
                <input type="hidden" name="pageSize"  value="@Model.PageSize" />
            </div>

            <!-- Sort Buttons -->
            <div class="d-flex flex-wrap gap-2 mt-3">
                <span class="text-muted small align-self-center me-1"><i class="bi bi-sort-down me-1"></i>Sort:</span>
                @{
                    var sortOptions = new[] {
                        ("BatchId","Newest First","BatchId","DESC"),
                        ("BatchName","Name A-Z","BatchName","ASC"),
                        ("CourseName","By Course","CourseName","ASC"),
                        ("StartDate","Start Date","StartDate","ASC"),
                        ("Capacity","Capacity","Capacity","DESC"),
                    };
                    foreach (var (col, label, scol, sdir) in sortOptions)
                    {
                        bool isActive = currentSortBy == scol;
                        <button type="button"
                                class="btn btn-outline-secondary sort-btn @(isActive ? "active" : "")"
                                onclick="setSortAndSubmit('@scol','@sdir')">
                            @label @(isActive ? (currentSortOrder=="ASC"?"↑":"↓") : "")
                        </button>
                    }
                }
            </div>
        </form>
    </div>
</div>

<!-- Batch Cards Grid -->
@if (!Model.Data.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-collection display-1 text-muted opacity-50"></i>
        <h5 class="text-muted mt-3">No batches found</h5>
        <p class="text-muted small">
            @if (!string.IsNullOrEmpty(currentSearch) || currentCourseFilter.HasValue || !string.IsNullOrEmpty(currentStatusFilter))
            {
                <span>No results matched your search or filter criteria.</span>
            }
            else
            {
                <span>Start by creating your first batch into a course.</span>
            }
        </p>
        <button type="button" class="btn btn-primary btn-sm px-4 rounded-pill mt-2" data-bs-toggle="modal" data-bs-target="#addBatchModal">
            <i class="bi bi-plus-circle me-1"></i> Add Batch
        </button>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var batch in Model.Data)
        {
            double fillPct = batch.Capacity > 0 ? Math.Min((double)batch.EnrolledCount / batch.Capacity * 100, 100) : 0;
            string fillClass = fillPct >= 90 ? "danger" : fillPct >= 70 ? "warning" : "";
            string statusBadgeClass = batch.Status switch {
                "Active"    => "status-badge-active",
                "Inactive"  => "status-badge-inactive",
                _           => "status-badge-completed"
            };

            <div class="col-12 col-md-6 col-xl-4">
                <div class="batch-card shadow-sm h-100">
                    <!-- Card Header -->
                    <div class="batch-card-header">
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="flex-grow-1 me-2">
                                <h6 class="fw-bold text-dark mb-1 lh-sm">@batch.BatchName</h6>
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="badge bg-primary-subtle text-primary rounded-pill small">
                                        <i class="bi bi-book-half me-1"></i>@batch.CourseName
                                    </span>
                                    <span class="small text-muted">@batch.AcademicYearName</span>
                                </div>
                            </div>
                            <span class="badge rounded-pill px-2 py-1 small @statusBadgeClass">@batch.Status</span>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="p-3">
                        <!-- Schedule Row -->
                        <div class="row g-2 mb-3">
                            @if (batch.StartDate.HasValue || batch.EndDate.HasValue)
                            {
                                <div class="col-12">
                                    <div class="d-flex align-items-center gap-2 text-muted small">
                                        <i class="bi bi-calendar3 text-primary"></i>
                                        <span>
                                            @(batch.StartDate.HasValue ? batch.StartDate.Value.ToString("dd MMM yyyy") : "—")
                                            &nbsp;→&nbsp;
                                            @(batch.EndDate.HasValue ? batch.EndDate.Value.ToString("dd MMM yyyy") : "—")
                                        </span>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(batch.StartTime) || !string.IsNullOrEmpty(batch.EndTime))
                            {
                                <div class="col-12">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-clock text-success small"></i>
                                        <span class="time-pill">@(batch.StartTime ?? "--:--")</span>
                                        <span class="text-muted small">to</span>
                                        <span class="time-pill">@(batch.EndTime ?? "--:--")</span>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(batch.RoomNo))
                            {
                                <div class="col-12">
                                    <div class="d-flex align-items-center gap-2 text-muted small">
                                        <i class="bi bi-door-open text-warning"></i>
                                        <span>Room: <strong class="text-dark">@batch.RoomNo</strong></span>
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- Capacity Progress -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="small text-muted">Enrolled</span>
                                <span class="small fw-semibold text-dark">@batch.EnrolledCount / @batch.Capacity</span>
                            </div>
                            <div class="capacity-bar">
                                <div class="capacity-fill @fillClass" style="width:@fillPct.ToString("F0")%"></div>
                            </div>
                        </div>

                        <!-- Faculty Allocation Button -->
                        <button type="button" 
                                class="btn btn-sm btn-outline-success w-100 mb-2 rounded-3 assign-faculty-btn"
                                data-batch-id="@batch.BatchId"
                                data-batch-name="@batch.BatchName">
                            <i class="bi bi-person-video3 me-1"></i> Faculty &amp; Subjects
                        </button>

                        <!-- Actions -->
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary flex-grow-1 edit-batch-btn"
                                    data-id="@batch.BatchId"
                                    data-bs-toggle="modal"
                                    data-bs-target="#editBatchModal">
                                <i class="bi bi-pencil me-1"></i>Edit
                            </button>
                            <button class="btn btn-sm btn-outline-danger delete-confirm-btn"
                                    data-url="@Url.Action("Delete","Batch",new{id=batch.BatchId})"
                                    data-title="Delete Batch"
                                    data-name="@batch.BatchName"
                                    data-return="">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @await Html.PartialAsync("_PaginationBar", new ViewDataDictionary(ViewData)
    {
        ["totalPages"]   = Model.TotalPages,
        ["currentPage"]  = Model.PageNumber,
        ["baseUrl"]      = Url.Action("Index","Batch"),
        ["pageSize"]     = Model.PageSize
    })
}

<!-- ====================================================
     ADD BATCH MODAL
     ==================================================== -->
<div class="modal fade" id="addBatchModal" tabindex="-1" aria-labelledby="addBatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form method="post" action="@Url.Action("Create","Batch")"
              id="addBatchForm" novalidate class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            @Html.AntiForgeryToken()
            <div class="modal-header p-3 px-4 text-white d-flex align-items-center justify-content-between border-0 flex-shrink-0"
                 style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #172554 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white"
                         style="width: 42px; height: 42px; background: linear-gradient(135deg, #3b82f6, #6366f1); font-size: 1.25rem; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);">
                        <i class="bi bi-calendar-plus"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="addBatchModalLabel">Add New Batch</h5>
                        <span class="text-light text-opacity-75" style="font-size: 0.75rem;">Fill in batch details, capacity &amp; schedule</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white m-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body p-4 bg-white">
                <div class="row g-3">
                    <!-- Batch Name -->
                    <div class="col-12">
                        <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">
                            Batch Name <span class="text-danger fw-bold">*</span>
                        </label>
                        <input type="text" class="form-control" name="BatchName"
                               placeholder="e.g. Batch A – Morning" maxlength="100" required />
                        <div class="field-error-msg" data-for="BatchName" style="display:none;">
                            <i class="bi bi-exclamation-circle-fill me-1"></i>Batch Name is required.
                        </div>
                    </div>

                    <!-- Course (Active courses only) -->
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">
                            Course <span class="text-danger fw-bold">*</span>
                        </label>
                        <select class="form-select" name="CourseId" required>
                            <option value="">-- Select Course --</option>
                            @foreach (var c in activeCourses)
                            {
                                <option value="@c.CourseId">@c.CourseName</option>
                            }
                        </select>
                        <div class="field-error-msg" data-for="CourseId" style="display:none;">
                            <i class="bi bi-exclamation-circle-fill me-1"></i>Course is required.
                        </div>
                    </div>

                    <!-- Academic Year (hidden – dynamic active year from DB) -->
                    <input type="hidden" name="AcademicYearId" value="@(ViewBag.CurrentAcademicYearId ?? 1)" />

                    <!-- Status -->
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">Status</label>
                        <select class="form-select" name="Status">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="Completed">Completed</option>
                        </select>
                    </div>

                    <!-- Start Date / End Date -->
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">Start Date</label>
                        <input type="date" class="form-control" name="StartDate" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">End Date</label>
                        <input type="date" class="form-control" name="EndDate" />
                    </div>

                    <!-- Start Time / End Time -->
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">Start Time</label>
                        <input type="time" class="form-control" name="StartTime" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">End Time</label>
                        <input type="time" class="form-control" name="EndTime" />
                    </div>

                    <!-- Capacity / Room No -->
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">
                            Capacity <span class="text-danger fw-bold">*</span>
                        </label>
                        <input type="number" class="form-control" name="Capacity"
                               min="1" max="500" placeholder="e.g. 50" required />
                        <div class="field-error-msg" data-for="Capacity" style="display:none;">
                            <i class="bi bi-exclamation-circle-fill me-1"></i>Capacity must be between 1 and 500.
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">Room No</label>
                        <input type="text" class="form-control" name="RoomNo"
                               placeholder="e.g. Room 101" maxlength="50" />
                    </div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer p-3 px-4 bg-light border-top d-flex align-items-center justify-content-end gap-2 flex-shrink-0">
                <button type="button" class="btn btn-sm btn-outline-secondary px-4 py-2 rounded-3 fw-semibold" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cancel
                </button>
                <button type="submit" class="btn btn-sm btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm" style="background: linear-gradient(135deg, #3b82f6, #6366f1); border: none;">
                    <i class="bi bi-plus-circle me-1"></i> Create Batch
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ====================================================
     EDIT BATCH MODAL
     ==================================================== -->
<div class="modal fade" id="editBatchModal" tabindex="-1" aria-labelledby="editBatchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header p-3 px-4 text-white d-flex align-items-center justify-content-between border-0 flex-shrink-0"
                 style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #172554 100%);">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-3 d-flex align-items-center justify-content-center text-white"
                         style="width: 42px; height: 42px; background: linear-gradient(135deg, #3b82f6, #1d4ed8); font-size: 1.25rem; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-white mb-0" id="editBatchModalLabel">Edit Batch</h5>
                        <span class="text-light text-opacity-75" style="font-size: 0.75rem;">Update batch details &amp; schedule</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white m-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 bg-white">
                <div id="editBatchLoader" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-muted mt-2 small">Loading batch details...</p>
                </div>
                <form method="post" action="@Url.Action("Edit","Batch")"
                      id="editBatchForm" novalidate style="display:none;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="BatchId" id="editBatchId" />
                    <input type="hidden" name="AcademicYearId" id="editAcademicYearId" />

                    <div class="row g-3 mb-4">
                        <!-- Batch Name -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">
                                Batch Name <span class="text-danger fw-bold">*</span>
                            </label>
                            <input type="text" class="form-control" name="BatchName" id="editBatchName"
                                   placeholder="e.g. Batch A – Morning" maxlength="100" required />
                            <div class="field-error-msg" data-for="BatchName" style="display:none;">
                                <i class="bi bi-exclamation-circle-fill me-1"></i>Batch Name is required.
                            </div>
                        </div>

                        <!-- Course (Active courses only) -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">
                                Course <span class="text-danger fw-bold">*</span>
                            </label>
                            <select class="form-select" name="CourseId" id="editCourseId" required>
                                <option value="">-- Select Course --</option>
                                @foreach (var c in activeCourses)
                                {
                                    <option value="@c.CourseId">@c.CourseName</option>
                                }
                            </select>
                            <div class="field-error-msg" data-for="CourseId" style="display:none;">
                                <i class="bi bi-exclamation-circle-fill me-1"></i>Course is required.
                            </div>
                        </div>

                        <!-- Status -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">Status</label>
                            <select class="form-select" name="Status" id="editStatus">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                                <option value="Completed">Completed</option>
                            </select>
                        </div>

                        <!-- Start Date / End Date -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">Start Date</label>
                            <input type="date" class="form-control" name="StartDate" id="editStartDate" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">End Date</label>
                            <input type="date" class="form-control" name="EndDate" id="editEndDate" />
                        </div>

                        <!-- Start Time / End Time -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">Start Time</label>
                            <input type="time" class="form-control" name="StartTime" id="editStartTime" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">End Time</label>
                            <input type="time" class="form-control" name="EndTime" id="editEndTime" />
                        </div>

                        <!-- Capacity / Room No -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">
                                Capacity <span class="text-danger fw-bold">*</span>
                            </label>
                            <input type="number" class="form-control" name="Capacity" id="editCapacity"
                                   min="1" max="500" placeholder="e.g. 50" required />
                            <div class="field-error-msg" data-for="Capacity" style="display:none;">
                                <i class="bi bi-exclamation-circle-fill me-1"></i>Capacity must be between 1 and 500.
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-dark text-uppercase mb-1" style="letter-spacing: 0.04em; font-size: 0.72rem;">Room No</label>
                            <input type="text" class="form-control" name="RoomNo" id="editRoomNo"
                                   placeholder="e.g. Room 101" maxlength="50" />
                        </div>
                    </div>

                    <div class="modal-footer p-3 px-4 bg-light border-top d-flex align-items-center justify-content-end gap-2 flex-shrink-0 mx-n4 mb-n4 rounded-bottom-4">
                        <button type="button" class="btn btn-sm btn-outline-secondary px-4 py-2 rounded-3 fw-semibold" data-bs-dismiss="modal">
                            <i class="bi bi-x-circle me-1"></i> Cancel
                        </button>
                        <button type="submit" class="btn btn-sm btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm" style="background: linear-gradient(135deg, #3b82f6, #6366f1); border: none;">
                            <i class="bi bi-check-circle me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Assign Faculty to Batch Subjects -->
<div class="modal fade" id="assignFacultyModal" tabindex="-1" aria-labelledby="assignFacultyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <!-- Header -->
            <div class="modal-header border-0 text-white p-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #047857 100%);">
                <div>
                    <span class="badge px-2.5 py-1 rounded-pill small fw-semibold mb-1 text-white" style="background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.3);">
                        <i class="bi bi-person-video3 me-1"></i> Faculty &amp; Subject Mapping
                    </span>
                    <h5 class="modal-title fw-bold text-white mb-0" id="assignFacultyModalLabel">Assign Faculty to Batch</h5>
                    <p class="text-white text-opacity-75 small mb-0 mt-1" id="assignFacultyBatchSubtitle">Loading batch information...</p>
                </div>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Body -->
            <div class="modal-body p-4">
                <!-- Loader -->
                <div id="assignFacultyLoader" class="text-center py-5">
                    <div class="spinner-border text-success" role="status"></div>
                    <p class="text-muted mt-2 small">Loading curriculum subjects and teachers...</p>
                </div>

                <!-- Main Content Form -->
                <div id="assignFacultyContent" style="display: none;">
                    <input type="hidden" id="assignFacultyBatchId" value="" />

                    <!-- Quick Guide Banner -->
                    <div class="alert alert-info border-0 rounded-3 p-3 mb-4 d-flex align-items-center gap-3" style="background: #f0fdf4; border: 1px solid #bbf7d0 !important; color: #166534;">
                        <i class="bi bi-info-circle-fill fs-4 text-success flex-shrink-0"></i>
                        <div class="small">
                            Map dedicated subject teachers to this batch. Once assigned, faculty members will see their lectures in <strong>Teacher Portal</strong>, and students will see their assigned teachers in <strong>Course &amp; Batches</strong>.
                        </div>
                    </div>

                    <!-- Subjects List Container -->
                    <div class="card border rounded-3 mb-3">
                        <div class="card-header bg-light py-2 px-3 d-flex align-items-center justify-content-between">
                            <span class="fw-bold small text-dark"><i class="bi bi-journal-bookmark me-1 text-primary"></i> Subjects for this Batch</span>
                            <span class="badge bg-secondary-subtle text-secondary rounded-pill" id="assignedSubjectsCountBadge">0 Subjects</span>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light small text-muted">
                                        <tr>
                                            <th style="width: 40%;">Subject</th>
                                            <th style="width: 50%;">Assigned Faculty Member</th>
                                            <th style="width: 10%;" class="text-center">Action</th>
                                        </tr>
                                    </thead>
                                    <tbody id="facultySubjectRowsList" class="small">
                                        <!-- Dynamically populated via JS -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Add Subject Row Option -->
                    <div class="d-flex align-items-center justify-content-between p-2 px-3 bg-light rounded-3 mb-2 flex-wrap gap-2">
                        <span class="small text-muted"><i class="bi bi-plus-circle me-1 text-primary"></i> Need to allocate another subject to this batch?</span>
                        <div class="d-flex align-items-center gap-2">
                            <select id="extraSubjectSelect" class="form-select form-select-sm" style="min-width: 200px;">
                                <option value="">-- Choose Subject to Add --</option>
                            </select>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="addExtraSubjectBtn">
                                <i class="bi bi-plus-lg me-1"></i> Add
                            </button>
                        </div>
                    </div>

                    <!-- Status Message Box -->
                    <div id="assignFacultyStatusMsg" class="mt-3" style="display: none;"></div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer border-0 p-3 bg-light">
                <button type="button" class="btn btn-sm btn-secondary px-3 py-2 rounded-3" data-bs-dismiss="modal">
                    Close
                </button>
                <button type="button" id="saveFacultyAssignmentsBtn" class="btn btn-sm btn-success px-4 py-2 rounded-3 fw-semibold shadow-sm" style="background: linear-gradient(135deg, #10b981, #059669); border: none;">
                    <i class="bi bi-check-circle me-1"></i> Save Faculty Assignments
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// =============================================
// Sort helper
// =============================================
function setSortAndSubmit(col, dir) {
    const form = document.getElementById('filterForm');
    form.querySelector('[name="sortBy"]').value    = col;
    form.querySelector('[name="sortOrder"]').value = dir;
    form.submit();
}

// =============================================
// Edit Batch — load via AJAX
// =============================================
document.querySelectorAll('.edit-batch-btn').forEach(btn => {
    btn.addEventListener('click', function () {
        const batchId = this.dataset.id;
        document.getElementById('editBatchLoader').style.display = 'block';
        document.getElementById('editBatchForm').style.display   = 'none';

        fetch(`/Batch/GetBatch?id=${batchId}`)
            .then(r => r.json())
            .then(data => {
                document.getElementById('editBatchId').value       = data.batchId;
                document.getElementById('editBatchName').value     = data.batchName || '';
                document.getElementById('editCourseId').value      = data.courseId;
                document.getElementById('editAcademicYearId').value = data.academicYearId;
                document.getElementById('editStatus').value        = data.status || 'Active';
                document.getElementById('editCapacity').value      = data.capacity ?? '';
                document.getElementById('editRoomNo').value        = data.roomNo || '';

                // Dates: format yyyy-MM-dd for date input
                document.getElementById('editStartDate').value = data.startDate ? data.startDate.substring(0, 10) : '';
                document.getElementById('editEndDate').value   = data.endDate   ? data.endDate.substring(0, 10)   : '';

                // Times: already "HH:mm" from service
                document.getElementById('editStartTime').value = data.startTime || '';
                document.getElementById('editEndTime').value   = data.endTime   || '';

                document.getElementById('editBatchLoader').style.display = 'none';
                document.getElementById('editBatchForm').style.display   = '';
            })
            .catch(() => {
                document.getElementById('editBatchLoader').innerHTML =
                    '<p class="text-danger"><i class="bi bi-exclamation-circle me-1"></i>Failed to load batch details. Please try again.</p>';
            });
    });
});

// Reset edit modal on close
document.getElementById('editBatchModal').addEventListener('hidden.bs.modal', () => {
    document.getElementById('editBatchLoader').style.display = 'block';
    document.getElementById('editBatchLoader').innerHTML     =
        '<div class="spinner-border text-primary" role="status"></div><p class="text-muted mt-2 small">Loading batch details...</p>';
    document.getElementById('editBatchForm').style.display   = 'none';
});

// =============================================
// Faculty & Subject Assignment Modal Logic
// =============================================
let currentAvailableTeachers = [];
let currentAvailableSubjects = [];
const assignFacultyModalEl = document.getElementById('assignFacultyModal');
const assignFacultyModal = new bootstrap.Modal(assignFacultyModalEl);

document.querySelectorAll('.assign-faculty-btn').forEach(btn => {
    btn.addEventListener('click', function () {
        const batchId = this.dataset.batchId;
        const batchName = this.dataset.batchName || 'Batch';

        document.getElementById('assignFacultyBatchId').value = batchId;
        document.getElementById('assignFacultyBatchSubtitle').innerHTML = 
            `Batch: <strong class="text-white">${batchName}</strong>`;
        document.getElementById('assignFacultyLoader').style.display = 'block';
        document.getElementById('assignFacultyContent').style.display = 'none';
        document.getElementById('assignFacultyStatusMsg').style.display = 'none';
        document.getElementById('saveFacultyAssignmentsBtn').disabled = false;
        document.getElementById('saveFacultyAssignmentsBtn').innerHTML = 
            '<i class="bi bi-check-circle me-1"></i> Save Faculty Assignments';

        assignFacultyModal.show();

        fetch(`/Batch/GetFacultyAssignments?batchId=${batchId}`)
            .then(r => r.json())
            .then(res => {
                if (!res.success || !res.data) {
                    throw new Error(res.message || 'Failed to load details.');
                }
                const data = res.data;
                document.getElementById('assignFacultyBatchSubtitle').innerHTML = 
                    `Batch: <strong class="text-white">${data.batchName}</strong> &bull; Course: <span class="badge bg-white text-dark rounded-pill px-2 py-0.5 ms-1">${data.courseName}</span>`;

                currentAvailableTeachers = data.availableTeachers || [];
                currentAvailableSubjects = data.availableSubjects || [];

                renderFacultySubjectRows(data.subjects || []);
                refreshExtraSubjectDropdown();

                document.getElementById('assignFacultyLoader').style.display = 'none';
                document.getElementById('assignFacultyContent').style.display = 'block';
            })
            .catch(err => {
                document.getElementById('assignFacultyLoader').innerHTML = 
                    `<p class="text-danger py-4"><i class="bi bi-exclamation-triangle-fill me-1"></i> ${err.message || 'Error loading batch faculty details.'}</p>`;
            });
    });
});

function renderFacultySubjectRows(subjects) {
    const tbody = document.getElementById('facultySubjectRowsList');
    tbody.innerHTML = '';

    if (!subjects || subjects.length === 0) {
        tbody.innerHTML = `
            <tr id="emptySubjectRow">
                <td colspan="3" class="text-center text-muted py-4">
                    <i class="bi bi-journal-x fs-3 d-block text-secondary mb-1"></i>
                    No subjects currently mapped. Select a subject below and click "Add".
                </td>
            </tr>
        `;
        document.getElementById('assignedSubjectsCountBadge').innerText = '0 Subjects';
        return;
    }

    subjects.forEach(sub => {
        appendSubjectRow(sub.subjectId, sub.subjectName, sub.teacherId);
    });

    updateSubjectCountBadge();
}

function appendSubjectRow(subjectId, subjectName, selectedTeacherId) {
    const emptyRow = document.getElementById('emptySubjectRow');
    if (emptyRow) emptyRow.remove();

    const tbody = document.getElementById('facultySubjectRowsList');

    const tr = document.createElement('tr');
    tr.dataset.subjectId = subjectId;

    let optionsHtml = '<option value="">-- Not Assigned / Unallocated --</option>';
    currentAvailableTeachers.forEach(t => {
        const isSelected = selectedTeacherId && selectedTeacherId === t.teacherId ? 'selected' : '';
        optionsHtml += `<option value="${t.teacherId}" ${isSelected}>${t.fullName} (${t.employeeCode || 'Faculty'})</option>`;
    });

    tr.innerHTML = `
        <td>
            <div class="fw-bold text-dark d-flex align-items-center gap-2">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center" style="width: 28px; height: 28px; font-size: 0.85rem;">
                    <i class="bi bi-journal-code"></i>
                </div>
                <span>${subjectName}</span>
            </div>
        </td>
        <td>
            <select class="form-select form-select-sm teacher-select">
                ${optionsHtml}
            </select>
        </td>
        <td class="text-center">
            <button type="button" class="btn btn-sm btn-outline-danger p-1 rounded-2 remove-subject-btn" title="Remove Subject from Batch">
                <i class="bi bi-trash"></i>
            </button>
        </td>
    `;

    tr.querySelector('.remove-subject-btn').addEventListener('click', function () {
        tr.remove();
        updateSubjectCountBadge();
        refreshExtraSubjectDropdown();
        if (tbody.querySelectorAll('tr[data-subject-id]').length === 0) {
            renderFacultySubjectRows([]);
        }
    });

    tbody.appendChild(tr);
    updateSubjectCountBadge();
}

function updateSubjectCountBadge() {
    const count = document.querySelectorAll('#facultySubjectRowsList tr[data-subject-id]').length;
    document.getElementById('assignedSubjectsCountBadge').innerText = `${count} Subject${count !== 1 ? 's' : ''}`;
}

function refreshExtraSubjectDropdown() {
    const select = document.getElementById('extraSubjectSelect');
    select.innerHTML = '<option value="">-- Choose Subject to Add --</option>';

    const currentSubjectIds = Array.from(document.querySelectorAll('#facultySubjectRowsList tr[data-subject-id]'))
        .map(tr => parseInt(tr.dataset.subjectId));

    currentAvailableSubjects.forEach(s => {
        if (!currentSubjectIds.includes(s.subjectId)) {
            const opt = document.createElement('option');
            opt.value = s.subjectId;
            opt.textContent = s.subjectName;
            select.appendChild(opt);
        }
    });
}

document.getElementById('addExtraSubjectBtn').addEventListener('click', function () {
    const select = document.getElementById('extraSubjectSelect');
    const subjectId = parseInt(select.value);
    if (!subjectId) return;

    const subjectObj = currentAvailableSubjects.find(s => s.subjectId === subjectId);
    if (!subjectObj) return;

    appendSubjectRow(subjectObj.subjectId, subjectObj.subjectName, null);
    refreshExtraSubjectDropdown();
});

document.getElementById('saveFacultyAssignmentsBtn').addEventListener('click', function () {
    const batchId = parseInt(document.getElementById('assignFacultyBatchId').value);
    if (!batchId) return;

    const rows = document.querySelectorAll('#facultySubjectRowsList tr[data-subject-id]');
    const assignments = [];

    rows.forEach(tr => {
        const subjectId = parseInt(tr.dataset.subjectId);
        const teacherSelect = tr.querySelector('.teacher-select');
        const teacherId = teacherSelect && teacherSelect.value ? parseInt(teacherSelect.value) : null;
        assignments.push({ subjectId, teacherId });
    });

    const btn = document.getElementById('saveFacultyAssignmentsBtn');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1" role="status"></span> Saving...';

    const statusMsg = document.getElementById('assignFacultyStatusMsg');
    statusMsg.style.display = 'none';

    fetch('/Batch/SaveFacultyAssignments', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({ batchId, assignments })
    })
    .then(r => r.json())
    .then(res => {
        if (res.success) {
            statusMsg.className = 'alert alert-success border-0 rounded-3 p-3 small d-flex align-items-center gap-2';
            statusMsg.innerHTML = '<i class="bi bi-check-circle-fill text-success fs-5"></i> <span>' + (res.message || 'Faculty assignments saved successfully!') + '</span>';
            statusMsg.style.display = 'flex';
            setTimeout(() => {
                location.reload();
            }, 1000);
        } else {
            btn.disabled = false;
            btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Save Faculty Assignments';
            statusMsg.className = 'alert alert-danger border-0 rounded-3 p-3 small d-flex align-items-center gap-2';
            statusMsg.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i> <span>' + (res.message || 'Failed to save assignments.') + '</span>';
            statusMsg.style.display = 'flex';
        }
    })
    .catch(err => {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-circle me-1"></i> Save Faculty Assignments';
        statusMsg.className = 'alert alert-danger border-0 rounded-3 p-3 small d-flex align-items-center gap-2';
        statusMsg.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i> <span>Error saving assignments. Please try again.</span>';
        statusMsg.style.display = 'flex';
    });
});
</script>
}
