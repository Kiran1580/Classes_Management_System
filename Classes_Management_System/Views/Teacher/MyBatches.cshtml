@model IEnumerable<CMS_BAL.ViewModels.TeacherBatchViewModel>
@{
    ViewData["Title"] = "My Batches & Schedule";
    var teacher = ViewBag.Teacher as CMS_BAL.ViewModels.TeacherViewModel ?? new CMS_BAL.ViewModels.TeacherViewModel();
}

<style>
    .hero-banner {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #172554 100%);
        border-radius: 1.25rem;
        box-shadow: 0 10px 25px -5px rgba(15,23,42,0.3);
    }
    .batch-card {
        background: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
    }
    .batch-card:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0,0,0,0.08)!important; }
</style>

<!-- Hero Banner -->
<div class="hero-banner p-4 mb-4 text-white">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-3 d-flex align-items-center justify-content-center text-white"
                 style="width:52px; height:52px; background: rgba(255,255,255,0.15); font-size: 1.6rem; backdrop-filter:blur(8px);">
                <i class="bi bi-calendar3"></i>
            </div>
            <div>
                <h2 class="text-white fw-bold mb-0">My Teaching Schedule &amp; Batches</h2>
                <p class="text-white-50 mb-0 small">Welcome, @teacher.FullName &bull; Employee ID: @(teacher.EmployeeCode ?? "—")</p>
            </div>
        </div>
        <div>
            <span class="badge bg-primary px-3 py-2 rounded-pill fs-6">
                <i class="bi bi-collection-fill me-1"></i>@(Model?.Count() ?? 0) Active Batches
            </span>
        </div>
    </div>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card border-0 shadow-sm p-5 text-center rounded-4 bg-white">
        <div class="mb-3">
            <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
        </div>
        <h5 class="fw-bold text-dark mb-1">No Batches Assigned Yet</h5>
        <p class="text-muted small mb-0">
            You are not currently assigned to teach any batches. Please contact the administrator to assign subjects and batches to your schedule.
        </p>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var batch in Model)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="batch-card shadow-sm h-100 p-4 d-flex flex-column">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">
                            @batch.CourseName
                        </span>
                        <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 small">
                            @batch.BatchStatus
                        </span>
                    </div>

                    <h5 class="fw-bold text-dark mb-1">@batch.BatchName</h5>
                    <p class="text-muted small mb-3">
                        <i class="bi bi-book-half text-primary me-1"></i>Subject: <strong class="text-dark">@batch.SubjectName</strong>
                    </p>

                    <div class="bg-light p-3 rounded-3 mb-3 small d-flex flex-column gap-2">
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="text-muted"><i class="bi bi-clock me-1"></i>Timing:</span>
                            <span class="fw-semibold text-dark">
                                @(string.IsNullOrEmpty(batch.StartTime) ? "Flexible" : $"{batch.StartTime} - {batch.EndTime}")
                            </span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="text-muted"><i class="bi bi-geo-alt me-1"></i>Room:</span>
                            <span class="fw-semibold text-dark">@(string.IsNullOrEmpty(batch.RoomNo) ? "Main Hall" : batch.RoomNo)</span>
                        </div>
                        <div class="d-flex align-items-center justify-content-between">
                            <span class="text-muted"><i class="bi bi-people me-1"></i>Enrolled Students:</span>
                            <span class="badge bg-primary text-white rounded-pill px-2">@batch.EnrolledStudentsCount</span>
                        </div>
                    </div>

                    <div class="mt-auto pt-2 border-top d-flex gap-2">
                        <span class="small text-muted d-flex align-items-center">
                            <i class="bi bi-check-circle-fill text-success me-1"></i>Teaching Active
                        </span>
                    </div>
                </div>
            </div>
        }
    </div>
}
