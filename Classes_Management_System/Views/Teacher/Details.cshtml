@model CMS_BAL.ViewModels.TeacherDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Teacher.FullName} - 360° Profile";
    string initials = (!string.IsNullOrWhiteSpace(Model.Teacher.FirstName) ? Model.Teacher.FirstName[0].ToString() : "") +
                      (!string.IsNullOrWhiteSpace(Model.Teacher.LastName) ? Model.Teacher.LastName[0].ToString() : "");
    string statusBadgeClass = Model.Teacher.IsActive ? "status-badge-active" : "status-badge-inactive";
    string statusText = Model.Teacher.IsActive ? "Active Faculty" : "Inactive";
}

<style>
    .profile-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #172554 100%);
        border-radius: 1.25rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(15,23,42,0.3);
    }
    .profile-avatar-lg {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid rgba(255,255,255,0.9);
        box-shadow: 0 8px 20px rgba(0,0,0,0.25);
    }
    .profile-avatar-lg-placeholder {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        color: #fff;
        font-weight: 700;
        font-size: 2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid rgba(255,255,255,0.9);
        box-shadow: 0 8px 20px rgba(99,102,241,0.4);
    }
    .status-badge-active   { background:#d1fae5; color:#065f46; border:1px solid #a7f3d0; }
    .status-badge-inactive { background:#fee2e2; color:#991b1b; border:1px solid #fca5a5; }

    .detail-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 1.25rem;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.02);
    }
    .detail-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.85rem 0;
        border-bottom: 1px solid #f1f5f9;
        font-size: 0.88rem;
    }
    .detail-row:last-child { border-bottom: none; }
    .detail-label { color: #64748b; font-weight: 500; }
    .detail-value { color: #0f172a; font-weight: 600; text-align: right; }
</style>

<!-- Profile Header Banner -->
<div class="profile-hero p-4 mb-4 text-white">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div class="d-flex align-items-center gap-4">
            @if (!string.IsNullOrEmpty(Model.Teacher.ProfileImage))
            {
                <img src="@Model.Teacher.ProfileImage" alt="@Model.Teacher.FullName" class="profile-avatar-lg" />
            }
            else
            {
                <div class="profile-avatar-lg-placeholder">@initials</div>
            }
            <div>
                <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                    <h2 class="text-white fw-bold mb-0">@Model.Teacher.FullName</h2>
                    <span class="badge bg-white text-dark px-2 py-1 rounded-pill" style="font-family: monospace; font-size: 0.8rem;">
                        @(Model.Teacher.EmployeeCode ?? "—")
                    </span>
                    <span class="badge rounded-pill px-2 py-1 small @statusBadgeClass">@statusText</span>
                </div>
                <p class="text-white-50 mb-0 small">
                    <i class="bi bi-mortarboard me-1"></i>@(Model.Teacher.Qualification ?? "Faculty") &bull;
                    <i class="bi bi-calendar-event me-1"></i>Joined: @(Model.Teacher.JoiningDate?.ToString("dd MMMM yyyy") ?? "—")
                </p>
            </div>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole("Admin"))
            {
                <a href="@Url.Action("Edit","Teacher",new{id=Model.Teacher.TeacherId})" class="btn btn-primary btn-sm px-3 rounded-pill shadow-sm">
                    <i class="bi bi-pencil me-1"></i> Edit Profile
                </a>
                <a href="@Url.Action("Index","Teacher")" class="btn btn-outline-light btn-sm px-3 rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Directory
                </a>
            }
            else
            {
                <a href="@Url.Action("Index","Dashboard")" class="btn btn-outline-light btn-sm px-3 rounded-pill">
                    <i class="bi bi-arrow-left me-1"></i> Dashboard
                </a>
            }
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- LEFT: Personal & Employment Details -->
    <div class="col-lg-5">
        <div class="detail-card p-4 h-100">
            <h6 class="fw-bold text-dark border-bottom pb-3 mb-3 d-flex align-items-center gap-2">
                <i class="bi bi-person-lines-fill text-primary"></i> Faculty Information
            </h6>

            <div class="detail-row">
                <span class="detail-label"><i class="bi bi-hash me-1 text-muted"></i> Employee Code</span>
                <span class="detail-value text-primary font-monospace">@(Model.Teacher.EmployeeCode ?? "—")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="bi bi-person me-1 text-muted"></i> Full Name</span>
                <span class="detail-value">@Model.Teacher.FullName</span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="bi bi-telephone me-1 text-muted"></i> Mobile Number</span>
                <span class="detail-value">
                    <a href="tel:@Model.Teacher.Mobile" class="text-decoration-none">@(Model.Teacher.Mobile ?? "—")</a>
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="bi bi-envelope me-1 text-muted"></i> Email Address</span>
                <span class="detail-value">
                    <a href="mailto:@Model.Teacher.Email" class="text-decoration-none">@(Model.Teacher.Email ?? "—")</a>
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="bi bi-mortarboard me-1 text-muted"></i> Qualification</span>
                <span class="detail-value">@(Model.Teacher.Qualification ?? "—")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="bi bi-calendar-check me-1 text-muted"></i> Joining Date</span>
                <span class="detail-value">@(Model.Teacher.JoiningDate?.ToString("dd MMM yyyy") ?? "—")</span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="bi bi-shield-check me-1 text-muted"></i> Account Status</span>
                <span class="detail-value">
                    <span class="badge rounded-pill px-2 py-1 small @statusBadgeClass">@statusText</span>
                </span>
            </div>
            <div class="detail-row">
                <span class="detail-label"><i class="bi bi-clock-history me-1 text-muted"></i> Profile Created</span>
                <span class="detail-value">@Model.Teacher.CreatedAt.ToString("dd MMM yyyy")</span>
            </div>
        </div>
    </div>

    <!-- RIGHT: Assigned Batches & Schedule -->
    <div class="col-lg-7">
        <div class="detail-card p-4 h-100">
            <div class="d-flex align-items-center justify-content-between border-bottom pb-3 mb-3">
                <h6 class="fw-bold text-dark mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-calendar3 text-success"></i> Assigned Batches &amp; Teaching Schedule
                </h6>
                <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-1">
                    @(Model.AssignedBatches?.Count() ?? 0) Active Assignments
                </span>
            </div>

            @if (Model.AssignedBatches == null || !Model.AssignedBatches.Any())
            {
                <div class="p-4 text-center text-muted">
                    <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary"></i>
                    <h6 class="fw-bold text-dark mb-1">No Batches Currently Assigned</h6>
                    <p class="small mb-0">This faculty member has not been mapped to any batch subjects yet. You can assign batches from Batch Management.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Batch Name</th>
                                <th>Course</th>
                                <th>Subject</th>
                                <th>Timing / Room</th>
                                <th class="text-center">Enrolled</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var batch in Model.AssignedBatches)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@batch.BatchName</div>
                                        <span class="badge bg-light text-secondary border px-1" style="font-size:0.7rem;">@batch.BatchStatus</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-primary-subtle text-primary rounded-pill">@batch.CourseName</span>
                                    </td>
                                    <td>
                                        <div class="fw-semibold text-dark">@batch.SubjectName</div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(batch.StartTime) && !string.IsNullOrEmpty(batch.EndTime))
                                        {
                                            <div><i class="bi bi-clock me-1 text-muted"></i>@batch.StartTime - @batch.EndTime</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        @if (!string.IsNullOrEmpty(batch.RoomNo))
                                        {
                                            <div class="text-muted" style="font-size:0.75rem;"><i class="bi bi-geo-alt me-1"></i>@batch.RoomNo</div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1">
                                            @batch.EnrolledStudentsCount Students
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
