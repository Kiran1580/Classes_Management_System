@model CMS_BAL.ViewModels.PagedResult<CMS_BAL.ViewModels.TeacherViewModel>
@{
    ViewData["Title"] = "Teacher Management";
    string currentSearch    = ViewBag.CurrentSearch as string ?? "";
    string currentSortBy    = ViewBag.CurrentSortBy as string ?? "TeacherId";
    string currentSortOrder = ViewBag.CurrentSortOrder as string ?? "DESC";
    string? currentStatus   = ViewBag.StatusFilter as string;

    var stats = (ViewBag.Stats as CMS_BAL.ViewModels.TeacherStatsViewModel)
                ?? new CMS_BAL.ViewModels.TeacherStatsViewModel();
}

<style>
    .stat-metric-card {
        background: #ffffff;
        border: 1px solid rgba(226,232,240,0.8);
        border-radius: 1rem;
        transition: transform 0.25s cubic-bezier(0.16,1,0.3,1), box-shadow 0.25s ease;
        position: relative;
        overflow: hidden;
    }
    .stat-metric-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px -5px rgba(0,0,0,0.08)!important; }
    .stat-metric-card::before { content:''; position:absolute; top:0; left:0; right:0; height:4px; }
    .metric-total::before    { background: linear-gradient(90deg,#3b82f6,#6366f1); }
    .metric-active::before   { background: linear-gradient(90deg,#10b981,#059669); }
    .metric-inactive::before { background: linear-gradient(90deg,#f59e0b,#d97706); }
    .metric-batches::before  { background: linear-gradient(90deg,#8b5cf6,#ec4899); }

    .icon-box { width:52px; height:52px; border-radius:0.85rem; display:flex; align-items:center; justify-content:center; font-size:1.4rem; color:white; box-shadow:0 8px 16px -4px rgba(0,0,0,0.15); }
    .icon-total    { background: linear-gradient(135deg,#3b82f6,#1d4ed8); }
    .icon-active   { background: linear-gradient(135deg,#10b981,#047857); }
    .icon-inactive { background: linear-gradient(135deg,#f59e0b,#b45309); }
    .icon-batches  { background: linear-gradient(135deg,#8b5cf6,#6d28d9); }

    .hero-banner {
        background: linear-gradient(135deg,#0f172a 0%,#1e293b 50%,#172554 100%);
        border-radius: 1.25rem;
        position: relative;
        overflow: hidden;
        box-shadow: 0 10px 25px -5px rgba(15,23,42,0.3);
    }

    .teacher-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 1rem;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        overflow: hidden;
    }
    .teacher-card:hover { transform: translateY(-3px); box-shadow: 0 10px 25px rgba(0,0,0,0.08)!important; }
    .teacher-card-header {
        background: linear-gradient(135deg,#f8faff 0%,#eff6ff 100%);
        border-bottom: 1px solid #e2e8f0;
        padding: 1rem 1.25rem 0.75rem;
    }

    .teacher-avatar {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid #fff;
        box-shadow: 0 3px 8px rgba(0,0,0,0.12);
    }
    .teacher-avatar-placeholder {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: linear-gradient(135deg,#6366f1,#8b5cf6);
        color: #fff;
        font-weight: 700;
        font-size: 1.15rem;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 3px 8px rgba(99,102,241,0.3);
    }

    .status-badge-active   { background:#d1fae5; color:#065f46; border:1px solid #a7f3d0; }
    .status-badge-inactive { background:#fee2e2; color:#991b1b; border:1px solid #fca5a5; }

    .contact-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.78rem;
        color: #475569;
        background: #f8fafc;
        padding: 0.25rem 0.6rem;
        border-radius: 0.5rem;
        border: 1px solid #e2e8f0;
    }

    .sort-btn { border-radius:2rem!important; font-size:0.8rem; padding:0.3rem 0.8rem; transition:all 0.2s; }
    .sort-btn.active { background:#3b82f6!important; color:#fff!important; border-color:#3b82f6!important; }
</style>

<!-- Hero Header Banner -->
<div class="hero-banner p-4 mb-4 text-white">
    <div class="row align-items-center g-3">
        <div class="col-md-8">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-3 d-flex align-items-center justify-content-center text-white"
                     style="width:52px; height:52px; background: rgba(255,255,255,0.15); font-size: 1.6rem; backdrop-filter:blur(8px);">
                    <i class="bi bi-person-video3"></i>
                </div>
                <div>
                    <h2 class="text-white fw-bold mb-0">Teacher &amp; Faculty Management</h2>
                    <p class="text-white-50 mb-0 small">Manage faculty profiles, employee codes &amp; batch teaching assignments</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 text-md-end">
            <a href="@Url.Action("Create","Teacher")" class="btn btn-primary btn-sm px-4 py-2 rounded-pill shadow-sm">
                <i class="bi bi-person-plus-fill me-2"></i>Add Teacher
            </a>
        </div>
    </div>
</div>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat-metric-card metric-total p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-500 mb-1">Total Teachers</div>
                    <div class="fw-bold fs-4 text-dark">@stats.TotalTeachers</div>
                </div>
                <div class="icon-box icon-total"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-metric-card metric-active p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-500 mb-1">Active Faculty</div>
                    <div class="fw-bold fs-4 text-dark">@stats.ActiveTeachers</div>
                </div>
                <div class="icon-box icon-active"><i class="bi bi-person-check"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-metric-card metric-inactive p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-500 mb-1">Inactive Teachers</div>
                    <div class="fw-bold fs-4 text-dark">@stats.InactiveTeachers</div>
                </div>
                <div class="icon-box icon-inactive"><i class="bi bi-person-dash"></i></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat-metric-card metric-batches p-3 shadow-sm">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <div class="text-muted small fw-500 mb-1">Assigned Batches</div>
                    <div class="fw-bold fs-4 text-dark">@stats.AssignedBatches</div>
                </div>
                <div class="icon-box icon-batches"><i class="bi bi-collection"></i></div>
            </div>
        </div>
    </div>
</div>

<!-- Filter / Search Bar -->
<div class="card border-0 shadow-sm mb-4" style="border-radius:1rem;">
    <div class="card-body p-3">
        <form method="get" action="@Url.Action("Index","Teacher")" id="filterForm">
            <div class="row g-2 align-items-end">
                <!-- Search Input -->
                <div class="col-12 col-md-8">
                    <label class="form-label small fw-bold text-muted mb-1">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" class="form-control border-start-0" id="searchInput" name="search"
                               value="@currentSearch" placeholder="Name, Employee Code, Mobile, Qualification...">
                        @if (!string.IsNullOrEmpty(currentSearch))
                        {
                            <a href="@Url.Action("Index","Teacher")" class="btn btn-outline-secondary border-start-0">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>

                <!-- Status Filter -->
                <div class="col-12 col-md-3">
                    <label class="form-label small fw-bold text-muted mb-1">Status</label>
                    <select class="form-select" name="statusFilter" onchange="document.getElementById('filterForm').submit()">
                        <option value="">All Status</option>
                        <option value="Active" selected="@(currentStatus == "Active")">Active</option>
                        <option value="Inactive" selected="@(currentStatus == "Inactive")">Inactive</option>
                    </select>
                </div>

                <!-- Submit Button -->
                <div class="col-12 col-md-1">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel"></i>
                    </button>
                </div>

                <input type="hidden" name="sortBy"    value="@currentSortBy" />
                <input type="hidden" name="sortOrder" value="@currentSortOrder" />
                <input type="hidden" name="pageSize"  value="@Model.PageSize" />
            </div>

            <!-- Sort Bar -->
            <div class="d-flex flex-wrap gap-2 mt-3">
                <span class="text-muted small align-self-center me-1"><i class="bi bi-sort-down me-1"></i>Sort:</span>
                @{
                    var sortOptions = new[] {
                        ("TeacherId", "Newest First", "TeacherId", "DESC"),
                        ("FirstName", "Name A-Z", "FirstName", "ASC"),
                        ("EmployeeCode", "Employee Code", "EmployeeCode", "ASC"),
                        ("JoiningDate", "Joining Date", "JoiningDate", "DESC")
                    };
                    foreach (var (col, label, scol, sdir) in sortOptions)
                    {
                        bool isActive = currentSortBy == scol;
                        <button type="button"
                                class="btn btn-outline-secondary sort-btn @(isActive ? "active" : "")"
                                onclick="setSortAndSubmit('@scol','@sdir')">
                            @label @(isActive ? (currentSortOrder == "ASC" ? "↑" : "↓") : "")
                        </button>
                    }
                }
            </div>
        </form>
    </div>
</div>

<!-- Teacher Cards Grid -->
@if (Model.Data == null || !Model.Data.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-people display-1 text-muted opacity-50"></i>
        <h5 class="text-muted mt-3">No teachers found</h5>
        <p class="text-muted small">
            @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentStatus))
            {
                <span>No results matched your search or filter criteria.</span>
            }
            else
            {
                <span>Start by onboarding your first faculty member.</span>
            }
        </p>
        <a href="@Url.Action("Create","Teacher")" class="btn btn-primary btn-sm px-4 rounded-pill mt-2">
            <i class="bi bi-person-plus me-1"></i> Register Teacher
        </a>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var teacher in Model.Data)
        {
            string initials = (!string.IsNullOrWhiteSpace(teacher.FirstName) ? teacher.FirstName[0].ToString() : "") +
                              (!string.IsNullOrWhiteSpace(teacher.LastName) ? teacher.LastName[0].ToString() : "");
            string statusBadgeClass = teacher.IsActive ? "status-badge-active" : "status-badge-inactive";
            string statusText = teacher.IsActive ? "Active" : "Inactive";

            <div class="col-12 col-md-6 col-xl-4">
                <div class="teacher-card shadow-sm h-100 d-flex flex-column">
                    <!-- Card Header -->
                    <div class="teacher-card-header">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <span class="badge bg-dark-subtle text-dark border px-2 py-1 rounded-pill" style="font-family: monospace; font-size: 0.72rem;">
                                @(teacher.EmployeeCode ?? "—")
                            </span>
                            <span class="badge rounded-pill px-2 py-1 small @statusBadgeClass">@statusText</span>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            @if (!string.IsNullOrEmpty(teacher.ProfileImage))
                            {
                                <img src="@teacher.ProfileImage" alt="@teacher.FullName" class="teacher-avatar" />
                            }
                            else
                            {
                                <div class="teacher-avatar-placeholder">@initials</div>
                            }
                            <div class="flex-grow-1 overflow-hidden">
                                <h6 class="fw-bold text-dark mb-0 text-truncate">@teacher.FullName</h6>
                                <span class="small text-muted d-block text-truncate" style="font-size:0.75rem;">
                                    <i class="bi bi-mortarboard me-1"></i>@(string.IsNullOrEmpty(teacher.Qualification) ? "Faculty" : teacher.Qualification)
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <!-- Contact Info -->
                        <div class="d-flex flex-column gap-2 mb-3">
                            <div class="contact-chip">
                                <i class="bi bi-telephone text-primary"></i>
                                <span class="fw-semibold">@(string.IsNullOrEmpty(teacher.Mobile) ? "—" : teacher.Mobile)</span>
                            </div>
                            <div class="contact-chip">
                                <i class="bi bi-envelope text-info"></i>
                                <span class="text-truncate">@(string.IsNullOrEmpty(teacher.Email) ? "—" : teacher.Email)</span>
                            </div>
                            <div class="contact-chip">
                                <i class="bi bi-calendar-check text-secondary"></i>
                                <span>Joined: @(teacher.JoiningDate?.ToString("dd MMM yyyy") ?? "—")</span>
                            </div>
                        </div>

                        <!-- Teaching Load Badge -->
                        <div class="mb-3">
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2 py-1">
                                <i class="bi bi-collection-fill me-1"></i>Assigned Batches: <strong>@teacher.AssignedBatchesCount</strong>
                            </span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 mt-auto pt-2 border-top">
                            <a href="@Url.Action("Details","Teacher",new{id=teacher.TeacherId})"
                               class="btn btn-sm btn-outline-primary flex-grow-1 rounded-3">
                                <i class="bi bi-eye me-1"></i> View 360°
                            </a>
                            <a href="@Url.Action("Edit","Teacher",new{id=teacher.TeacherId})"
                               class="btn btn-sm btn-outline-secondary rounded-3" title="Edit Teacher">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger rounded-3 delete-confirm-btn"
                                    data-url="@Url.Action("Delete","Teacher",new{id=teacher.TeacherId})"
                                    data-title="Delete Teacher"
                                    data-name="@teacher.FullName"
                                    title="Delete Teacher">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @await Html.PartialAsync("_PaginationBar", new ViewDataDictionary(ViewData)
    {
        ["totalPages"]   = Model.TotalPages,
        ["currentPage"]  = Model.PageNumber,
        ["baseUrl"]      = Url.Action("Index","Teacher"),
        ["pageSize"]     = Model.PageSize
    })
}

@section Scripts {
<script>
function setSortAndSubmit(col, dir) {
    const form = document.getElementById('filterForm');
    form.querySelector('[name="sortBy"]').value    = col;
    form.querySelector('[name="sortOrder"]').value = dir;
    form.submit();
}
</script>
}
