@model CMS_DAL.Models.StudentDashboardStats
@{
    ViewData["Title"] = "Student Portal";
}

<div class="card border-0 shadow-sm rounded-4 p-4 text-white mb-4" style="background: linear-gradient(135deg, #0284c7 0%, #0369a1 100%);">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
        <div>
            <span class="badge bg-white text-primary px-3 py-1 rounded-pill fw-semibold mb-2">
                <i class="bi bi-mortarboard-fill me-1"></i> Student Desk
            </span>
            <h3 class="fw-bold mb-1">Hello, @(User.Identity?.Name ?? "Student") 🎒</h3>
            <p class="text-white text-opacity-75 mb-0">Enrolled in: <strong>@Model.CourseName (@Model.BatchName)</strong></p>
        </div>
        <div class="d-flex gap-2">
            <a href="#" class="btn btn-warning fw-bold px-3">
                <i class="bi bi-qr-code me-1"></i> Pay Fees
            </a>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <!-- Attendance -->
    <div class="col-12 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 text-center">
            <div class="text-secondary small fw-semibold text-uppercase">Attendance</div>
            <div class="fs-2 fw-bold text-primary mt-1">@Model.AttendancePercentage%</div>
            <small class="text-success">Overall Attendance</small>
        </div>
    </div>

    <!-- Total Fees -->
    <div class="col-12 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 text-center">
            <div class="text-secondary small fw-semibold text-uppercase">Total Course Fee</div>
            <div class="fs-2 fw-bold text-dark mt-1">₹@Model.TotalFees.ToString("N0")</div>
            <small class="text-muted">Assigned fee</small>
        </div>
    </div>

    <!-- Paid Fees -->
    <div class="col-12 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 text-center">
            <div class="text-secondary small fw-semibold text-uppercase">Fees Paid</div>
            <div class="fs-2 fw-bold text-success mt-1">₹@Model.PaidFees.ToString("N0")</div>
            <small class="text-success"><i class="bi bi-check-circle"></i> Verified & Paid</small>
        </div>
    </div>

    <!-- Pending Fees -->
    <div class="col-12 col-md-3">
        <div class="card border-0 shadow-sm rounded-3 p-3 text-center">
            <div class="text-secondary small fw-semibold text-uppercase">Balance Due</div>
            <div class="fs-2 fw-bold text-danger mt-1">₹@Model.PendingFees.ToString("N0")</div>
            @if (Model.PendingPaymentReviews > 0)
            {
                <small class="text-warning"><i class="bi bi-clock-history"></i> Verification in progress</small>
            }
            else
            {
                <small class="text-danger">Installment pending</small>
            }
        </div>
    </div>
</div>
