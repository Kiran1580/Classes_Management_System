@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - Admin Portal | Class Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --sidebar-width: 260px;
            --topbar-height: 64px;
            --primary-accent: #3b82f6;
            --dark-bg: #0f172a;
            --sidebar-bg: #1e293b;
            --card-bg: #ffffff;
        }
        body {
            background-color: #f1f5f9;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            margin: 0;
            color: #334155;
            overflow-x: hidden;
        }
        #sidebar {
            width: var(--sidebar-width);
            background-color: var(--sidebar-bg);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1050;
            overflow-y: auto;
            transition: transform 0.3s ease-in-out;
            box-shadow: 2px 0 12px rgba(0,0,0,0.15);
        }
        #main-content {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: margin-left 0.3s ease-in-out;
            width: 100%;
        }

        /* Desktop Mode (>= 992px) */
        @@media (min-width: 992px) {
            #sidebar {
                transform: translateX(0) !important;
            }
            #main-content {
                margin-left: var(--sidebar-width);
                width: calc(100% - var(--sidebar-width));
            }
            #sidebarToggleBtn,
            #sidebarCloseBtn,
            #sidebarBackdrop {
                display: none !important;
            }
        }

        /* Mobile & Tablet Mode (< 992px) */
        @@media (max-width: 991.98px) {
            #sidebar {
                transform: translateX(-100%);
                width: 280px;
            }
            #sidebar.show {
                transform: translateX(0);
                box-shadow: 0 0 30px rgba(0,0,0,0.5);
            }
            #main-content {
                margin-left: 0 !important;
                width: 100% !important;
            }
            .content-body {
                padding: 1rem !important;
            }
            .topbar {
                padding: 0 1rem !important;
            }
        }

        #sidebarBackdrop {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(3px);
            z-index: 1040;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }
        #sidebarBackdrop.show {
            opacity: 1;
            visibility: visible;
        }

        .topbar {
            height: var(--topbar-height);
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            position: sticky;
            top: 0;
            z-index: 999;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
        }
        .sidebar-brand {
            padding: 1.1rem 1.25rem;
            color: #ffffff;
            font-weight: 700;
            font-size: 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .nav-section-title {
            padding: 0.85rem 1.25rem 0.35rem;
            font-size: 0.68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #94a3b8;
        }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0.65rem 1.25rem;
            color: #cbd5e1;
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 500;
            transition: all 0.15s ease;
            border-left: 3px solid transparent;
        }
        .sidebar-link:hover {
            color: #ffffff;
            background-color: rgba(255,255,255,0.05);
            border-left-color: var(--primary-accent);
        }
        .sidebar-link.active {
            color: #ffffff;
            background-color: rgba(59, 130, 246, 0.15);
            border-left-color: var(--primary-accent);
            font-weight: 600;
        }
        .sidebar-link i {
            font-size: 1.1rem;
            width: 20px;
            text-align: center;
        }
        .content-body {
            padding: 1.75rem;
            flex: 1;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Mobile Backdrop -->
    <div id="sidebarBackdrop"></div>

    <!-- Responsive Sidebar Drawer -->
    <aside id="sidebar">
        <div class="sidebar-brand d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-mortarboard-fill text-primary fs-4"></i>
                <div>
                    <span class="d-block lh-1 text-white">ClassCMS</span>
                    <small class="text-secondary fw-normal" style="font-size: 0.72rem;">Admin Console</small>
                </div>
            </div>
            <button id="sidebarCloseBtn" type="button" class="btn btn-sm text-secondary p-1 border-0" aria-label="Close navigation">
                <i class="bi bi-x-lg fs-5"></i>
            </button>
        </div>

        <div class="py-2">
            <div class="nav-section-title">Overview</div>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="sidebar-link active">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <div class="nav-section-title">Academic & Batches</div>
            <a href="#" class="sidebar-link" title="Academic Years & Sessions">
                <i class="bi bi-calendar3"></i> Academic Sessions
            </a>
            <a href="#" class="sidebar-link" title="Courses & Subjects">
                <i class="bi bi-book"></i> Courses & Subjects
            </a>
            <a href="#" class="sidebar-link" title="Batches & Teacher Mapping">
                <i class="bi bi-people-fill"></i> Batches
            </a>

            <div class="nav-section-title">People & Admissions</div>
            <a href="#" class="sidebar-link" title="Inquiries CRM">
                <i class="bi bi-funnel"></i> Inquiries (CRM)
            </a>
            <a href="#" class="sidebar-link" title="Student Directory">
                <i class="bi bi-person-badge"></i> Students
            </a>
            <a href="#" class="sidebar-link" title="Teacher Staff">
                <i class="bi bi-person-video3"></i> Teachers
            </a>

            <div class="nav-section-title">Finance & Billing</div>
            <a href="#" class="sidebar-link" title="Fee Structures & Due Dues">
                <i class="bi bi-cash-coin"></i> Student Fees
            </a>
            <a href="#" class="sidebar-link" title="UPI Payment Verification">
                <i class="bi bi-qr-code-scan"></i> UPI Verifications
            </a>
            <a href="#" class="sidebar-link" title="Institute Expenses">
                <i class="bi bi-receipt"></i> Expenses
            </a>

            <div class="nav-section-title">Operations & Reports</div>
            <a href="#" class="sidebar-link">
                <i class="bi bi-calendar-check"></i> Attendance
            </a>
            <a href="#" class="sidebar-link">
                <i class="bi bi-award"></i> Exams & Results
            </a>
            <a href="#" class="sidebar-link">
                <i class="bi bi-file-earmark-bar-graph"></i> Reports & Analytics
            </a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div id="main-content">
        <header class="topbar shadow-sm">
            <div class="d-flex align-items-center gap-2 gap-sm-3">
                <button id="sidebarToggleBtn" class="btn btn-sm btn-light border p-1 px-2 text-dark" type="button" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <h6 class="mb-0 text-dark fw-bold text-truncate" style="max-width: 180px;">@ViewData["Title"]</h6>
            </div>
            <div class="d-flex align-items-center gap-2 gap-sm-3">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill d-none d-sm-inline-block">
                    <i class="bi bi-shield-check me-1"></i> Admin
                </span>
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1 gap-sm-2" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle"></i>
                        <span class="d-none d-md-inline">@(User.Identity?.Name ?? "Admin")</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><h6 class="dropdown-header">Logged in as Administrator</h6></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a asp-area="" asp-controller="Account" asp-action="Logout" class="dropdown-item text-danger">
                                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="content-body">
            @RenderBody()
        </main>

        <footer class="py-3 px-3 px-md-4 bg-white border-top text-secondary small text-center">
            &copy; @DateTime.Now.Year - Classes & Coaching Management System
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.getElementById('sidebarToggleBtn');
            const closeBtn = document.getElementById('sidebarCloseBtn');
            const backdrop = document.getElementById('sidebarBackdrop');

            function openSidebar() {
                sidebar.classList.add('show');
                backdrop.classList.add('show');
                document.body.style.overflow = 'hidden';
            }

            function closeSidebar() {
                sidebar.classList.remove('show');
                backdrop.classList.remove('show');
                document.body.style.overflow = '';
            }

            if (toggleBtn) toggleBtn.addEventListener('click', openSidebar);
            if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
            if (backdrop) backdrop.addEventListener('click', closeSidebar);

            // Close sidebar on mobile when navigation links are clicked
            document.querySelectorAll('#sidebar .sidebar-link').forEach(function (link) {
                link.addEventListener('click', function () {
                    if (window.innerWidth < 992) {
                        closeSidebar();
                    }
                });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
