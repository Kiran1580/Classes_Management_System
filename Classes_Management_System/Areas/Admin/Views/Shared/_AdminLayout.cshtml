@using System.Security.Claims
@inject CMS_BAL.Services.Interfaces.IAuthService AuthService
@{
    var pendingRegistrations = (await AuthService.GetPendingRegistrationsAsync())?.ToList() ?? new List<CMS_DAL.Models.PendingRegistrationUser>();
    var pendingCount = pendingRegistrations.Count;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>@ViewData["Title"] - Admin Portal | Class Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --sidebar-width: 260px;
            --topbar-height: 64px;
            --primary-accent: #3b82f6;
            --dark-bg: #0f172a;
            --sidebar-bg: #1e293b;
            --card-bg: #ffffff;
        }
        body {
            background-color: #f1f5f9;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
            margin: 0;
            color: #334155;
            overflow-x: hidden;
        }
        #sidebar {
            width: var(--sidebar-width);
            background-color: var(--sidebar-bg);
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            z-index: 1050;
            overflow-y: auto;
            transition: transform 0.3s ease-in-out;
            box-shadow: 2px 0 12px rgba(0,0,0,0.15);
        }
        #main-content {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            transition: margin-left 0.3s ease-in-out;
            width: 100%;
        }

        /* Desktop Mode (>= 992px) */
        @@media (min-width: 992px) {
            #sidebar {
                transform: translateX(0) !important;
            }
            #main-content {
                margin-left: var(--sidebar-width);
                width: calc(100% - var(--sidebar-width));
            }
            #sidebarToggleBtn,
            #sidebarCloseBtn,
            #sidebarBackdrop {
                display: none !important;
            }
        }

        /* Mobile & Tablet Mode (< 992px) */
        @@media (max-width: 991.98px) {
            #sidebar {
                transform: translateX(-100%);
                width: 280px;
            }
            #sidebar.show {
                transform: translateX(0);
                box-shadow: 0 0 30px rgba(0,0,0,0.5);
            }
            #main-content {
                margin-left: 0 !important;
                width: 100% !important;
            }
            .content-body {
                padding: 1rem !important;
            }
            .topbar {
                padding: 0 1rem !important;
            }
        }

        #sidebarBackdrop {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(3px);
            z-index: 1040;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.3s ease, visibility 0.3s ease;
        }
        #sidebarBackdrop.show {
            opacity: 1;
            visibility: visible;
        }

        .topbar {
            height: var(--topbar-height);
            background: #ffffff;
            border-bottom: 1px solid #e2e8f0;
            position: sticky;
            top: 0;
            z-index: 999;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 1.5rem;
        }
        .sidebar-brand {
            padding: 1.1rem 1.25rem;
            color: #ffffff;
            font-weight: 700;
            font-size: 1.1rem;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        .nav-section-title {
            padding: 0.85rem 1.25rem 0.35rem;
            font-size: 0.68rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #94a3b8;
        }
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 0.85rem;
            padding: 0.65rem 1.25rem;
            color: #cbd5e1;
            text-decoration: none;
            font-size: 0.88rem;
            font-weight: 500;
            transition: all 0.15s ease;
            border-left: 3px solid transparent;
        }
        .sidebar-link:hover {
            color: #ffffff;
            background-color: rgba(255,255,255,0.05);
            border-left-color: var(--primary-accent);
        }
        .sidebar-link.active {
            color: #ffffff;
            background-color: rgba(59, 130, 246, 0.15);
            border-left-color: var(--primary-accent);
            font-weight: 600;
        }
        .sidebar-link i {
            font-size: 1.1rem;
            width: 20px;
            text-align: center;
        }
        .content-body {
            padding: 1.75rem;
            flex: 1;
        }

        /* Common Reusable Grid Pagination Styling */
        .grid-pagination-bar {
            background-color: #ffffff;
            transition: all 0.2s ease;
        }
        .grid-pagination-info {
            font-size: 0.82rem;
            color: #64748b;
        }
        .grid-pagesize-select {
            font-size: 0.78rem;
            font-weight: 500;
            border-color: #cbd5e1;
            border-radius: 0.375rem;
            padding: 0.25rem 1.75rem 0.25rem 0.65rem;
            color: #334155;
            background-color: #f8fafc;
            cursor: pointer;
            transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
        }
        .grid-pagesize-select:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.15);
            background-color: #ffffff;
        }
        .grid-pagination-nav .page-link.grid-pagination-link {
            color: #475569;
            border-color: #e2e8f0;
            font-weight: 600;
            font-size: 0.8rem;
            border-radius: 0.375rem;
            margin: 0 2px;
            padding: 0.35rem 0.65rem;
            transition: all 0.15s ease-in-out;
        }
        .grid-pagination-nav .page-item.active .page-link.grid-pagination-link {
            background: linear-gradient(135deg, #3b82f6, #2563eb);
            border-color: #2563eb;
            color: #fff;
            box-shadow: 0 2px 6px rgba(37, 99, 235, 0.3);
        }
        .grid-pagination-nav .page-link.grid-pagination-link:hover {
            background-color: #f1f5f9;
            color: #1e293b;
        }
        .grid-pagination-nav .page-item.disabled .page-link.grid-pagination-link {
            color: #94a3b8;
            background-color: #f8fafc;
            border-color: #e2e8f0;
        }

        /* Attractive Form Validation Styles */
        .input-group.is-invalid-group {
            border-radius: 0.375rem;
        }
        .input-group.is-invalid-group .form-control,
        .input-group.is-invalid-group .input-group-text {
            border-color: #ef4444 !important;
        }
        .input-group.is-invalid-group .form-control:focus {
            box-shadow: 0 0 0 0.25rem rgba(239, 68, 68, 0.15) !important;
        }
        .field-error-msg {
            display: none;
            font-size: 0.78rem;
            font-weight: 500;
            color: #ef4444 !important;
            animation: fadeInError 0.2s ease-in-out;
        }
        @@keyframes fadeInError {
            from { opacity: 0; transform: translateY(-3px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Mobile Backdrop -->
    <div id="sidebarBackdrop"></div>

    <!-- Responsive Sidebar Drawer -->
    <aside id="sidebar">
        <div class="sidebar-brand d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-mortarboard-fill text-primary fs-4"></i>
                <div>
                    <span class="d-block lh-1 text-white">ClassCMS</span>
                    <small class="text-secondary fw-normal" style="font-size: 0.72rem;">Admin Console</small>
                </div>
            </div>
            <button id="sidebarCloseBtn" type="button" class="btn btn-sm text-secondary p-1 border-0" aria-label="Close navigation">
                <i class="bi bi-x-lg fs-5"></i>
            </button>
        </div>

        <div class="py-2">
            <div class="nav-section-title">Overview</div>
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="sidebar-link active">
                <i class="bi bi-speedometer2"></i> Dashboard
            </a>

            <div class="nav-section-title">Academic & Batches</div>
            <a href="#" class="sidebar-link" title="Academic Years & Sessions">
                <i class="bi bi-calendar3"></i> Academic Sessions
            </a>
            <a asp-area="Admin" asp-controller="Course" asp-action="Index" class="sidebar-link" title="Courses & Subjects">
                <i class="bi bi-book"></i> Courses & Subjects
            </a>
            <a href="#" class="sidebar-link" title="Batches & Teacher Mapping">
                <i class="bi bi-people-fill"></i> Batches
            </a>

            <div class="nav-section-title">People & Admissions</div>
            <a asp-area="Admin" asp-controller="UserApproval" asp-action="Index" class="sidebar-link" title="User Registrations Approval">
                <i class="bi bi-person-check"></i> Registrations Approval
            </a>
            <a href="#" class="sidebar-link" title="Inquiries CRM">
                <i class="bi bi-funnel"></i> Inquiries (CRM)
            </a>
            <a href="#" class="sidebar-link" title="Student Directory">
                <i class="bi bi-person-badge"></i> Students
            </a>
            <a href="#" class="sidebar-link" title="Teacher Staff">
                <i class="bi bi-person-video3"></i> Teachers
            </a>

            <div class="nav-section-title">Finance & Billing</div>
            <a href="#" class="sidebar-link" title="Fee Structures & Due Dues">
                <i class="bi bi-cash-coin"></i> Student Fees
            </a>
            <a href="#" class="sidebar-link" title="UPI Payment Verification">
                <i class="bi bi-qr-code-scan"></i> UPI Verifications
            </a>
            <a href="#" class="sidebar-link" title="Institute Expenses">
                <i class="bi bi-receipt"></i> Expenses
            </a>

            <div class="nav-section-title">Operations & Reports</div>
            <a href="#" class="sidebar-link">
                <i class="bi bi-calendar-check"></i> Attendance
            </a>
            <a href="#" class="sidebar-link">
                <i class="bi bi-award"></i> Exams & Results
            </a>
            <a href="#" class="sidebar-link">
                <i class="bi bi-file-earmark-bar-graph"></i> Reports & Analytics
            </a>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div id="main-content">
        <header class="topbar shadow-sm">
            <div class="d-flex align-items-center gap-2 gap-sm-3">
                <button id="sidebarToggleBtn" class="btn btn-sm btn-light border p-1 px-2 text-dark" type="button" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <h6 class="mb-0 text-dark fw-bold text-truncate" style="max-width: 180px;">@ViewData["Title"]</h6>
            </div>
            <div class="d-flex align-items-center gap-2 gap-sm-3">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill d-none d-sm-inline-block">
                    <i class="bi bi-shield-check me-1"></i> Admin
                </span>

                <!-- Notification Bell Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-light border position-relative p-0 rounded-circle d-flex align-items-center justify-content-center shadow-none" 
                            style="width: 38px; height: 38px; background-color: #ffffff;" 
                            type="button" 
                            id="notificationDropdownBtn" 
                            data-bs-toggle="dropdown" 
                            aria-expanded="false" 
                            title="Notifications">
                        <i class="bi bi-bell fs-5 text-dark"></i>
                        @if (pendingCount > 0)
                        {
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white" style="font-size: 0.65rem; padding: 0.3em 0.55em;">
                                @pendingCount
                                <span class="visually-hidden">unread notifications</span>
                            </span>
                        }
                    </button>
                    <div class="dropdown-menu dropdown-menu-end shadow-lg p-0 rounded-3 border-0 mt-2" style="width: 330px; max-width: 92vw;">
                        <div class="p-3 bg-light border-bottom d-flex align-items-center justify-content-between rounded-top-3">
                            <span class="fw-bold small text-dark"><i class="bi bi-bell-fill text-warning me-1"></i> Notifications</span>
                            @if (pendingCount > 0)
                            {
                                <span class="badge bg-warning text-dark rounded-pill" style="font-size: 0.72rem;">@pendingCount Pending</span>
                            }
                        </div>
                        <div style="max-height: 290px; overflow-y: auto;">
                            @if (pendingCount == 0)
                            {
                                <div class="p-4 text-center text-muted small">
                                    <i class="bi bi-check-circle text-success fs-3 d-block mb-1"></i>
                                    <div>No new notifications</div>
                                    <span class="text-secondary" style="font-size: 0.75rem;">All registrations are reviewed!</span>
                                </div>
                            }
                            else
                            {
                                @foreach (var user in pendingRegistrations.Take(5))
                                {
                                    <a asp-area="Admin" asp-controller="UserApproval" asp-action="Index" class="dropdown-item py-2 px-3 border-bottom d-flex align-items-start gap-2 text-wrap">
                                        <div class="rounded-circle @(user.RoleName == "Teacher" ? "bg-warning bg-opacity-10 text-warning" : "bg-primary bg-opacity-10 text-primary") d-flex align-items-center justify-content-center flex-shrink-0 mt-1" style="width: 30px; height: 30px; font-size: 0.8rem;">
                                            <i class="bi @(user.RoleName == "Teacher" ? "bi-person-video3" : "bi-mortarboard")"></i>
                                        </div>
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center justify-content-between">
                                                <span class="fw-semibold text-dark small" style="font-size: 0.8rem;">@user.FullName</span>
                                                <span class="badge @(user.RoleName == "Teacher" ? "bg-warning-subtle text-warning" : "bg-primary-subtle text-primary") px-1 py-0 rounded" style="font-size: 0.65rem;">@user.RoleName</span>
                                            </div>
                                            <div class="text-secondary text-truncate" style="font-size: 0.72rem; max-width: 220px;">@user.Email</div>
                                            <div class="text-muted" style="font-size: 0.68rem;"><i class="bi bi-clock me-1"></i>@user.CreatedAt.ToString("dd MMM, hh:mm tt")</div>
                                        </div>
                                    </a>
                                }
                            }
                        </div>
                        <div class="p-2 text-center bg-light border-top rounded-bottom-3">
                            <a asp-area="Admin" asp-controller="UserApproval" asp-action="Index" class="text-primary text-decoration-none small fw-semibold" style="font-size: 0.8rem;">
                                View All Approvals (@pendingCount) <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- User Profile Dropdown -->
                <div class="dropdown">
                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center gap-1 gap-sm-2" type="button" data-bs-toggle="dropdown">
                        <i class="bi bi-person-circle"></i>
                        <span class="d-none d-md-inline">@(User.Identity?.Name ?? "Admin")</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                        <li><h6 class="dropdown-header">Logged in as Administrator</h6></li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a asp-area="" asp-controller="Account" asp-action="Logout" class="dropdown-item text-danger">
                                <i class="bi bi-box-arrow-right me-2"></i> Sign Out
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main class="content-body">
            @RenderBody()
        </main>

        <footer class="py-3 px-3 px-md-4 bg-white border-top text-secondary small text-center">
            &copy; @DateTime.Now.Year - Classes & Coaching Management System
        </footer>
    </div>

    <!-- Toast Notification Container (Top Right, Auto-dismiss in 4 seconds) -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 9999; margin-top: 10px;">
        @if (TempData["SuccessMessage"] != null)
        {
            <div id="appToastSuccess" class="toast align-items-center border-0 shadow-lg rounded-3 mb-2 bg-white" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000" style="border-left: 5px solid #10b981 !important; min-width: 320px;">
                <div class="d-flex align-items-center p-3">
                    <div class="rounded-circle bg-success bg-opacity-10 text-success d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 38px; height: 38px; font-size: 1.25rem;">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div class="toast-body p-0 flex-grow-1">
                        <div class="fw-bold text-dark small">Success</div>
                        <div class="text-secondary small">@TempData["SuccessMessage"]</div>
                    </div>
                    <button type="button" class="btn-close ms-2 me-0" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div id="appToastError" class="toast align-items-center border-0 shadow-lg rounded-3 mb-2 bg-white" role="alert" aria-live="assertive" aria-atomic="true" data-bs-delay="4000" style="border-left: 5px solid #ef4444 !important; min-width: 320px;">
                <div class="d-flex align-items-center p-3">
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-flex align-items-center justify-content-center me-3 flex-shrink-0" style="width: 38px; height: 38px; font-size: 1.25rem;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div class="toast-body p-0 flex-grow-1">
                        <div class="fw-bold text-dark small">Error</div>
                        <div class="text-secondary small">@TempData["ErrorMessage"]</div>
                    </div>
                    <button type="button" class="btn-close ms-2 me-0" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>
        }
    </div>

    <!-- Global Delete Confirmation Modal -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-body text-center p-4 pt-5">
                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger d-inline-flex align-items-center justify-content-center mb-3" style="width: 64px; height: 64px; font-size: 1.8rem;">
                        <i class="bi bi-trash3-fill"></i>
                    </div>
                    <h5 class="fw-bold text-dark mb-2" id="deleteModalTitle">Confirm Delete</h5>
                    <p class="text-secondary small mb-4 px-2" id="deleteModalMessage">
                        Are you sure you want to delete this item? This action cannot be undone.
                    </p>
                    <div class="d-flex align-items-center justify-content-center gap-2">
                        <button type="button" class="btn btn-light px-4 py-2 rounded-3 text-secondary fw-semibold border" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <form id="globalDeleteForm" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="returnAction" id="globalDeleteReturnAction" value="" />
                            <button type="submit" class="btn btn-danger px-4 py-2 rounded-3 fw-semibold shadow-sm d-flex align-items-center gap-2">
                                <i class="bi bi-trash3"></i> Yes, Delete
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Sidebar controls
            const sidebar = document.getElementById('sidebar');
            const toggleBtn = document.getElementById('sidebarToggleBtn');
            const closeBtn = document.getElementById('sidebarCloseBtn');
            const backdrop = document.getElementById('sidebarBackdrop');

            function openSidebar() {
                sidebar.classList.add('show');
                backdrop.classList.add('show');
                document.body.style.overflow = 'hidden';
            }

            function closeSidebar() {
                sidebar.classList.remove('show');
                backdrop.classList.remove('show');
                document.body.style.overflow = '';
            }

            if (toggleBtn) toggleBtn.addEventListener('click', openSidebar);
            if (closeBtn) closeBtn.addEventListener('click', closeSidebar);
            if (backdrop) backdrop.addEventListener('click', closeSidebar);

            // Close sidebar on mobile when navigation links are clicked
            document.querySelectorAll('#sidebar .sidebar-link').forEach(function (link) {
                link.addEventListener('click', function () {
                    if (window.innerWidth < 992) {
                        closeSidebar();
                    }
                });
            });

            // Auto-trigger Toast Notifications with 4-second delay
            document.querySelectorAll('.toast-container .toast').forEach(function(toastEl) {
                const toast = new bootstrap.Toast(toastEl, { delay: 2000, autohide: true });
                toast.show();
            });

            // Global Form Custom Validation Handler (prevents browser default popup, shows attractive red validation)
            document.addEventListener('submit', function (e) {
                const form = e.target;
                if (!form || !form.hasAttribute('novalidate')) return;

                let hasError = false;
                let firstInvalidInput = null;

                const requiredInputs = form.querySelectorAll('input[required], textarea[required], select[required]');
                requiredInputs.forEach(input => {
                    const val = input.value ? input.value.trim() : '';
                    const group = input.closest('.input-group');
                    const parent = input.closest('.mb-3') || input.parentElement;
                    const errorEl = parent ? parent.querySelector('.field-error-msg') : null;

                    if (!val) {
                        hasError = true;
                        if (!firstInvalidInput) firstInvalidInput = input;
                        input.classList.add('is-invalid');
                        if (group) group.classList.add('is-invalid-group');
                        if (errorEl) errorEl.style.display = 'block';
                    } else {
                        input.classList.remove('is-invalid');
                        if (group) group.classList.remove('is-invalid-group');
                        if (errorEl) errorEl.style.display = 'none';
                    }
                });

                if (hasError) {
                    e.preventDefault();
                    e.stopPropagation();
                    if (firstInvalidInput) firstInvalidInput.focus();
                }
            });

            // Clear red error state immediately when user types
            document.addEventListener('input', function (e) {
                const input = e.target;
                const val = input.value ? input.value.trim() : '';
                if (val.length > 0) {
                    input.classList.remove('is-invalid');
                    const group = input.closest('.input-group');
                    if (group) group.classList.remove('is-invalid-group');
                    const parent = input.closest('.mb-3') || input.parentElement;
                    const errorEl = parent ? parent.querySelector('.field-error-msg') : null;
                    if (errorEl) errorEl.style.display = 'none';
                }
            });

            // Reset validation errors when any modal closes
            document.addEventListener('hidden.bs.modal', function (e) {
                const modal = e.target;
                modal.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
                modal.querySelectorAll('.is-invalid-group').forEach(el => el.classList.remove('is-invalid-group'));
                modal.querySelectorAll('.field-error-msg').forEach(el => el.style.display = 'none');
            });

            // Global Delete Confirmation Modal Handler
            document.addEventListener('click', function(e) {
                const btn = e.target.closest('.delete-confirm-btn');
                if (!btn) return;
                e.preventDefault();

                const url = btn.getAttribute('data-url');
                const name = btn.getAttribute('data-name') || 'this item';
                const title = btn.getAttribute('data-title') || 'Confirm Delete';
                const returnAction = btn.getAttribute('data-return') || '';

                document.getElementById('deleteModalTitle').innerText = title;
                document.getElementById('deleteModalMessage').innerHTML = `Are you sure you want to delete <strong class="text-dark">"${name}"</strong>?<br><span class="text-muted small">This action cannot be undone.</span>`;
                document.getElementById('globalDeleteForm').setAttribute('action', url);
                document.getElementById('globalDeleteReturnAction').value = returnAction;

                const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('deleteConfirmModal'));
                modal.show();
            });
        });

        // Common Grid Page Size Change Handler
        function changeGridPageSize(selectElem, sizeParamName, pageParamName) {
            const url = new URL(window.location.href);
            url.searchParams.set(sizeParamName, selectElem.value);
            url.searchParams.set(pageParamName, '1'); // Reset to page 1 on page size change
            window.location.href = url.toString();
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
