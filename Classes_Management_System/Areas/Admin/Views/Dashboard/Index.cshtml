@model CMS_DAL.Models.AdminDashboardStats
@{
    ViewData["Title"] = "Executive Dashboard";
}

<!-- Welcome Banner -->
<div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #1e293b 0%, #334155 100%); color: white;">
    <div class="card-body p-3 p-md-4">
        <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
            <div>
                <span class="badge bg-primary-subtle text-primary mb-2 px-2 px-sm-3 py-1 rounded-pill fw-semibold" style="font-size: 0.75rem;">
                    <i class="bi bi-stars me-1"></i> Phase 1 Active & Initialized
                </span>
                <h4 class="fw-bold mb-1 fs-4 fs-md-3">Welcome, @(User.Identity?.Name ?? "Administrator") 👋</h4>
                <p class="text-light text-opacity-75 mb-0 small">
                    Real-time operational overview of your institute.
                </p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <span class="badge bg-dark bg-opacity-50 border border-secondary text-light px-2 py-1 rounded-3 fw-normal small">
                    <i class="bi bi-database-check text-success me-1"></i> ADO.NET + SP
                </span>
                <span class="badge bg-dark bg-opacity-50 border border-secondary text-light px-2 py-1 rounded-3 fw-normal small">
                    <i class="bi bi-calendar-event text-info me-1"></i> 2025-2026
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Metrics Cards -->
<div class="row g-2 g-md-3 mb-4">
    <!-- Total Students -->
    <div class="col-6 col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-semibold text-uppercase" style="font-size: 0.7rem;">Students</div>
                    <div class="fs-4 fs-md-3 fw-bold text-dark mt-1">@Model.TotalStudents</div>
                    <small class="text-success text-truncate d-block" style="font-size: 0.72rem;"><i class="bi bi-arrow-up-right"></i> Active</small>
                </div>
                <div class="rounded-3 bg-primary bg-opacity-10 p-2 p-md-3 text-primary fs-4 fs-md-3">
                    <i class="bi bi-mortarboard"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Batches -->
    <div class="col-6 col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-semibold text-uppercase" style="font-size: 0.7rem;">Batches</div>
                    <div class="fs-4 fs-md-3 fw-bold text-dark mt-1">@Model.TotalBatches</div>
                    <small class="text-muted text-truncate d-block" style="font-size: 0.72rem;">Active courses</small>
                </div>
                <div class="rounded-3 bg-info bg-opacity-10 p-2 p-md-3 text-info fs-4 fs-md-3">
                    <i class="bi bi-collection"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Faculty / Teachers -->
    <div class="col-6 col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-semibold text-uppercase" style="font-size: 0.7rem;">Teachers</div>
                    <div class="fs-4 fs-md-3 fw-bold text-dark mt-1">@Model.TotalTeachers</div>
                    <small class="text-muted text-truncate d-block" style="font-size: 0.72rem;">Faculty staff</small>
                </div>
                <div class="rounded-3 bg-warning bg-opacity-10 p-2 p-md-3 text-warning fs-4 fs-md-3">
                    <i class="bi bi-person-video3"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Active Inquiries -->
    <div class="col-6 col-md-6 col-xl-3">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-body d-flex align-items-center justify-content-between p-3">
                <div>
                    <div class="text-secondary small fw-semibold text-uppercase" style="font-size: 0.7rem;">Inquiries</div>
                    <div class="fs-4 fs-md-3 fw-bold text-dark mt-1">@Model.ActiveInquiries</div>
                    <small class="text-primary text-truncate d-block" style="font-size: 0.72rem;">CRM leads</small>
                </div>
                <div class="rounded-3 bg-purple bg-opacity-10 p-2 p-md-3 text-secondary fs-4 fs-md-3">
                    <i class="bi bi-funnel-fill"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Financial Summary Row -->
<div class="row g-2 g-md-3 mb-4">
    <!-- Revenue Collected -->
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-secondary small fw-semibold text-uppercase" style="font-size: 0.72rem;">Revenue Collected</span>
                    <span class="badge bg-success-subtle text-success">Verified</span>
                </div>
                <h3 class="fw-bold text-success mb-1 fs-3">₹@Model.TotalCollectedRevenue.ToString("N0")</h3>
                <small class="text-muted" style="font-size: 0.75rem;">Approved payments through UPI & Cash</small>
            </div>
        </div>
    </div>

    <!-- Pending Fees -->
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-secondary small fw-semibold text-uppercase" style="font-size: 0.72rem;">Total Fees Due</span>
                    <span class="badge bg-danger-subtle text-danger">Pending</span>
                </div>
                <h3 class="fw-bold text-danger mb-1 fs-3">₹@Model.PendingFeesAmount.ToString("N0")</h3>
                <small class="text-muted" style="font-size: 0.75rem;">Total outstanding across students</small>
            </div>
        </div>
    </div>

    <!-- Pending Proof Verifications -->
    <div class="col-12 col-md-4">
        <div class="card border-0 shadow-sm rounded-3 h-100 bg-white border-start border-warning border-4">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-1">
                    <span class="text-secondary small fw-semibold text-uppercase" style="font-size: 0.72rem;">UPI Verification Queue</span>
                    <span class="badge bg-warning text-dark">Action Needed</span>
                </div>
                <h3 class="fw-bold text-warning mb-1 fs-3">@Model.PendingFeeApprovals</h3>
                <small class="text-muted" style="font-size: 0.75rem;">Payment screenshots awaiting review</small>
            </div>
        </div>
    </div>
</div>

<!-- Quick Actions & System Info -->
<div class="row g-3">
    <div class="col-12 col-lg-8">
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="mb-0 fw-bold"><i class="bi bi-grid-fill text-primary me-2"></i>Quick Management Shortcuts</h6>
            </div>
            <div class="card-body pt-0">
                <div class="row g-2">
                    <div class="col-6 col-md-3">
                        <div class="p-3 border rounded-3 text-center bg-light">
                            <i class="bi bi-person-plus text-primary fs-3 d-block mb-1"></i>
                            <span class="small fw-semibold">New Student</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 border rounded-3 text-center bg-light">
                            <i class="bi bi-people text-success fs-3 d-block mb-1"></i>
                            <span class="small fw-semibold">Create Batch</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 border rounded-3 text-center bg-light">
                            <i class="bi bi-credit-card text-warning fs-3 d-block mb-1"></i>
                            <span class="small fw-semibold">Collect Fee</span>
                        </div>
                    </div>
                    <div class="col-6 col-md-3">
                        <div class="p-3 border rounded-3 text-center bg-light">
                            <i class="bi bi-chat-left-dots text-info fs-3 d-block mb-1"></i>
                            <span class="small fw-semibold">Log Inquiry</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card border-0 shadow-sm rounded-3 h-100">
            <div class="card-header bg-white py-3 border-0">
                <h6 class="mb-0 fw-bold"><i class="bi bi-cpu text-info me-2"></i>Architecture Status</h6>
            </div>
            <div class="card-body pt-0">
                <ul class="list-group list-group-flush small">
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-secondary">Data Access:</span>
                        <span class="fw-semibold text-primary">ADO.NET + Stored Procedures</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-secondary">Database:</span>
                        <span class="fw-semibold text-dark">SQL Server (27 Tables)</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-secondary">Auth:</span>
                        <span class="fw-semibold text-success">Cookie Auth + BCrypt</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between px-0">
                        <span class="text-secondary">Responsive:</span>
                        <span class="badge bg-success-subtle text-success">Mobile & Desktop</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
