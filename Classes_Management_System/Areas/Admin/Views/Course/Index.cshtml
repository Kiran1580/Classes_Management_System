<!-- MODAL: ADD SUBJECT (QUICK POPUP FROM COURSE VIEW) -->
<div class="modal fade" id="addSubjectModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <form asp-action="CreateSubject" method="post" id="addSubjectFormCourseView" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnAction" value="Index" />
                <div class="p-3 px-4 text-white d-flex align-items-center justify-content-between" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-bottom: 1px solid rgba(255,255,255,0.1);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 d-flex align-items-center justify-content-center text-white" style="width: 40px; height: 40px; background: linear-gradient(135deg, #8b5cf6, #6d28d9); font-size: 1.15rem; box-shadow: 0 4px 12px rgba(139, 92, 246, 0.4);">
                            <i class="bi bi-journal-plus"></i>
                        </div>
                        <div>
                            <h6 class="modal-title fw-bold text-white mb-0">Add New Subject</h6>
                            <span class="text-light text-opacity-75" style="font-size: 0.75rem;">Create a syllabus subject for course mapping</span>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body p-4 bg-white">
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark text-uppercase" style="letter-spacing: 0.04em; font-size: 0.72rem;">Subject Name <span class="text-danger fw-bold">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-journal-bookmark-fill text-primary"></i></span>
                            <input name="SubjectName" class="form-control border-start-0" placeholder="e.g. Physics, Chemistry, Mathematics, English" required maxlength="100" autofocus />
                        </div>
                        <div class="field-error-msg">
                            <i class="bi bi-exclamation-circle-fill me-1"></i>Please enter subject name.
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold text-dark text-uppercase" style="letter-spacing: 0.04em; font-size: 0.72rem;">Description / Outline</label>
                        <textarea name="Description" class="form-control" rows="2" placeholder="Brief topics covered or curriculum highlights" maxlength="500"></textarea>
                    </div>

                    <div class="p-3 bg-light rounded-3 border d-flex align-items-center justify-content-between">
                        <div>
                            <div class="fw-bold text-dark small">Active Status</div>
                            <div class="text-muted" style="font-size: 0.72rem;">Available immediately for mapping to courses</div>
                        </div>
                        <div class="form-check form-switch m-0">
                            <input type="hidden" name="IsActive" value="false" />
                            <input name="IsActive" class="form-check-input fs-5" type="checkbox" role="switch" id="subjectActiveSwitch" value="true" checked />
                        </div>
                    </div>
                </div>

                <div class="modal-footer p-3 px-4 bg-light border-top d-flex align-items-center justify-content-end gap-2 flex-shrink-0">
                    <button type="button" class="btn btn-sm btn-outline-secondary px-4 py-2 rounded-3 fw-semibold" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-sm btn-primary px-4 py-2 rounded-3 fw-semibold shadow-sm" style="background: linear-gradient(135deg, #3b82f6, #6366f1); border: none;">
                        <i class="bi bi-check-circle-fill me-1"></i> Save Subject
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.setAddDuration = function (val) {
            const input = document.getElementById('addCourseDurationInput');
            if (input) input.value = val;
        };

        window.setEditDuration = function (val) {
            const input = document.getElementById('editCourseDurationInput');
            if (input) input.value = val;
        };

        document.addEventListener('DOMContentLoaded', function () {
            // Checkbox change handlers for visual active state
            document.querySelectorAll('.add-sub-check').forEach(chk => {
                chk.addEventListener('change', function () {
                    const tile = this.closest('.sub-tile-card');
                    if (tile) tile.classList.toggle('active-selected', this.checked);
                });
            });

            document.querySelectorAll('.edit-sub-check').forEach(chk => {
                chk.addEventListener('change', function () {
                    const tile = this.closest('.sub-tile-card');
                    if (tile) tile.classList.toggle('active-selected', this.checked);
                });
            });

            // Toggle all in Add Course Modal
            const addSelectAllBtn = document.getElementById('addSelectAllSubjectsBtn');
            if (addSelectAllBtn) {
                addSelectAllBtn.addEventListener('click', function () {
                    const checkboxes = document.querySelectorAll('.add-sub-check');
                    const allChecked = Array.from(checkboxes).every(c => c.checked);
                    checkboxes.forEach(c => {
                        c.checked = !allChecked;
                        const tile = c.closest('.sub-tile-card');
                        if (tile) tile.classList.toggle('active-selected', !allChecked);
                    });
                });
            }

            // Toggle all in Edit Course Modal
            const editSelectAllBtn = document.getElementById('editSelectAllSubjectsBtn');
            if (editSelectAllBtn) {
                editSelectAllBtn.addEventListener('click', function () {
                    const checkboxes = document.querySelectorAll('.edit-sub-check');
                    const allChecked = Array.from(checkboxes).every(c => c.checked);
                    checkboxes.forEach(c => {
                        c.checked = !allChecked;
                        const tile = c.closest('.sub-tile-card');
                        if (tile) tile.classList.toggle('active-selected', !allChecked);
                    });
                });
            }

            // Edit Course Modal Trigger
            document.querySelectorAll('.edit-course-btn').forEach(btn => {
                btn.addEventListener('click', function () {
                    const id = this.dataset.id;
                    const name = this.dataset.name;
                    const duration = this.dataset.duration || '';
                    const desc = this.dataset.desc || '';
                    const active = this.dataset.active === 'true';
                    const subjectsCsv = this.dataset.subjects || '';
                    const subjectIds = subjectsCsv ? subjectsCsv.split(',').map(s => s.trim()) : [];

                    document.getElementById('editCourseId').value = id;
                    document.getElementById('editCourseName').value = name;
                    document.getElementById('editCourseDurationInput').value = duration;
                    document.getElementById('editCourseDesc').value = desc;
                    document.getElementById('editCourseActiveSwitch').checked = active;

                    document.querySelectorAll('.edit-sub-check').forEach(chk => {
                        const subId = chk.dataset.subid;
                        const isSelected = subjectIds.includes(subId);
                        chk.checked = isSelected;
                        const tile = chk.closest('.sub-tile-card');
                        if (tile) tile.classList.toggle('active-selected', isSelected);
                    });

                    const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editCourseModal'));
                    modal.show();
                });
            });
        });
    </script>
}
